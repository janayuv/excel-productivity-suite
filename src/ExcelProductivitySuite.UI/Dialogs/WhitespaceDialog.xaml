<controls:BaseDialogWindow x:Class="ExcelProductivitySuite.UI.Dialogs.WhitespaceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:ExcelProductivitySuite.UI.Controls"
        mc:Ignorable="d"
        Title="Trim &amp; Clean Spaces - Excel Productivity Suite"
        Height="460" Width="560"
        Background="#F8F9FA">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Brushes.xaml" />
                <ResourceDictionary Source="../Themes/Typography.xaml" />
                <ResourceDictionary Source="../Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{StaticResource BrandPrimaryBrush}" CornerRadius="4" Width="28" Height="28" Margin="0,0,10,0">
                    <TextBlock Text="␣" Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel>
                    <TextBlock Text="Trim &amp; Normalize Spaces" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Clean irregular whitespace, non-breaking spaces, and extra gaps" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- Options -->
        <GroupBox Grid.Row="1" Header="Whitespace Cleanup Strategy" Style="{StaticResource ModernGroupBoxStyle}">
            <StackPanel>
                <RadioButton x:Name="CollapseRadio" Content="Collapse excess spaces (normalize multiple spaces to single space + trim)" IsChecked="True" Style="{StaticResource ModernRadioButtonStyle}" Checked="OptionChanged" />
                <RadioButton x:Name="LeadingTrailingRadio" Content="Leading and trailing spaces only (standard trim)" Style="{StaticResource ModernRadioButtonStyle}" Checked="OptionChanged" />
                <RadioButton x:Name="RemoveAllRadio" Content="Remove all spaces completely" Style="{StaticResource ModernRadioButtonStyle}" Checked="OptionChanged" />
                <CheckBox x:Name="ConvertNBSPCheckBox" Content="Convert non-breaking spaces (ASCII 160 / \u00A0) to standard spaces" IsChecked="True" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,6,0,0" Checked="OptionChanged" Unchecked="OptionChanged" />
            </StackPanel>
        </GroupBox>

        <!-- Live Preview -->
        <DockPanel Grid.Row="2" Margin="0,8,0,0">
            <TextBlock DockPanel.Dock="Top" Text="Live Preview (First 10 Cells):" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
            <controls:LivePreviewTable x:Name="PreviewTable" />
        </DockPanel>

        <!-- Footer -->
        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="Safe in-memory operation" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="CancelButton_Click" IsCancel="True" />
                <Button Content="Clean Spaces" Style="{StaticResource PrimaryButtonStyle}" Click="ApplyButton_Click" IsDefault="True" />
            </StackPanel>
        </DockPanel>
    </Grid>
</controls:BaseDialogWindow>
