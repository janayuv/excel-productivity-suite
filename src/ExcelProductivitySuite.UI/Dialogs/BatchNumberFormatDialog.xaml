<controls:BaseDialogWindow x:Class="ExcelProductivitySuite.UI.Dialogs.BatchNumberFormatDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:ExcelProductivitySuite.UI.Controls"
        mc:Ignorable="d"
        Title="Batch Number Formatting - Excel Productivity Suite"
        Height="560" Width="740"
        Background="#F8F9FA">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Brushes.xaml" />
                <ResourceDictionary Source="../Themes/Typography.xaml" />
                <ResourceDictionary Source="../Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{StaticResource BrandPrimaryBrush}" CornerRadius="4" Width="28" Height="28" Margin="0,0,10,0">
                    <TextBlock Text="💲" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel>
                    <TextBlock Text="Batch Number Formatting" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Apply standardized financial, decimal, percentage, and currency masks across selected cells" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- Configuration Grid -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Categories & Presets -->
            <GroupBox Grid.Column="0" Header="Format Categories" Style="{StaticResource ModernGroupBoxStyle}">
                <ListBox x:Name="CategoryList" BorderThickness="0" Background="Transparent" SelectionChanged="CategoryList_SelectionChanged">
                    <ListBoxItem Content="💵 Currency" Tag="Currency" IsSelected="True" Padding="6,8" />
                    <ListBoxItem Content="📑 Accounting" Tag="Accounting" Padding="6,8" />
                    <ListBoxItem Content="📊 Percentage" Tag="Percentage" Padding="6,8" />
                    <ListBoxItem Content="🔢 Standard Number" Tag="DecimalNumber" Padding="6,8" />
                    <ListBoxItem Content="🧱 Whole Integer" Tag="Integer" Padding="6,8" />
                    <ListBoxItem Content="🔬 Scientific" Tag="Scientific" Padding="6,8" />
                    <ListBoxItem Content="🏷️ Compact Millions (M)" Tag="CompactUnits" Padding="6,8" />
                </ListBox>
            </GroupBox>

            <!-- Right: Controls, Preview & Custom Mask -->
            <Border Grid.Column="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Parameters Panel -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <!-- Decimal Places -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Decimal Places:" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <ComboBox x:Name="DecimalsCombo" Grid.Column="1" Style="{StaticResource ModernComboBoxStyle}" SelectionChanged="Control_Changed">
                                <ComboBoxItem Content="0" />
                                <ComboBoxItem Content="1" />
                                <ComboBoxItem Content="2" IsSelected="True" />
                                <ComboBoxItem Content="3" />
                                <ComboBoxItem Content="4" />
                            </ComboBox>
                            <CheckBox x:Name="ThousandSepCheck" Grid.Column="2" Content="Use 1000s Separator (,)" IsChecked="True" VerticalAlignment="Center" Margin="14,0,0,0" Click="Control_Changed" />
                        </Grid>

                        <!-- Currency Symbol -->
                        <Grid x:Name="CurrencyRow" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Currency Symbol:" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <ComboBox x:Name="CurrencyCombo" Grid.Column="1" Style="{StaticResource ModernComboBoxStyle}" SelectionChanged="Control_Changed">
                                <ComboBoxItem Content="$ (United States Dollar)" Tag="$" IsSelected="True" />
                                <ComboBoxItem Content="€ (Euro)" Tag="€" />
                                <ComboBoxItem Content="£ (British Pound)" Tag="£" />
                                <ComboBoxItem Content="₹ (Indian Rupee)" Tag="₹" />
                                <ComboBoxItem Content="¥ (Japanese Yen / Chinese Yuan)" Tag="¥" />
                                <ComboBoxItem Content="None" Tag="" />
                            </ComboBox>
                        </Grid>

                        <!-- Negative Numbers -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Negative Numbers:" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <ComboBox x:Name="NegativeCombo" Grid.Column="1" Style="{StaticResource ModernComboBoxStyle}" SelectionChanged="Control_Changed">
                                <ComboBoxItem Content="-1,234.56 (Standard Minus)" IsSelected="True" />
                                <ComboBoxItem Content="(1,234.56) (Parentheses)" />
                                <ComboBoxItem Content="[Red]-1,234.56 (Red Minus)" />
                                <ComboBoxItem Content="[Red](1,234.56) (Red Parentheses)" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>

                    <!-- Format String Box -->
                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Excel NumberFormat Mask:" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" />
                            <TextBox x:Name="FormatMaskBox" Grid.Row="1" Style="{StaticResource ModernTextBoxStyle}" FontFamily="Consolas" FontSize="11" Margin="0,4,0,0" TextChanged="FormatMaskBox_TextChanged" />
                        </Grid>
                    </Border>

                    <!-- Live Sample Preview -->
                    <GroupBox Grid.Row="3" Header="Live Format Preview" Style="{StaticResource ModernGroupBoxStyle}">
                        <Grid Margin="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Positive (+12345.678):" FontWeight="SemiBold" Margin="0,3" />
                            <TextBlock x:Name="PosPreviewText" Grid.Row="0" Grid.Column="1" FontFamily="Consolas" Foreground="#047857" FontWeight="SemiBold" Margin="0,3" Text="$12,345.68" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Negative (-12345.678):" FontWeight="SemiBold" Margin="0,3" />
                            <TextBlock x:Name="NegPreviewText" Grid.Row="1" Grid.Column="1" FontFamily="Consolas" Foreground="#B91C1C" FontWeight="SemiBold" Margin="0,3" Text="-$12,345.68" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Zero (0.00):" FontWeight="SemiBold" Margin="0,3" />
                            <TextBlock x:Name="ZeroPreviewText" Grid.Row="2" Grid.Column="1" FontFamily="Consolas" Foreground="#4B5563" FontWeight="SemiBold" Margin="0,3" Text="$0.00" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Active Cell Sample:" FontWeight="SemiBold" Margin="0,3" />
                            <TextBlock x:Name="ActiveCellPreviewText" Grid.Row="3" Grid.Column="1" FontFamily="Consolas" Foreground="{StaticResource BrandPrimaryBrush}" FontWeight="SemiBold" Margin="0,3" Text="$100.00" />
                        </Grid>
                    </GroupBox>
                </Grid>
            </Border>
        </Grid>

        <!-- Status -->
        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,8,0,12" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Text="Ready to apply number formatting." />

        <!-- Action Buttons -->
        <DockPanel Grid.Row="3" LastChildFill="False">
            <Button x:Name="CloseBtn" Content="Close" Style="{StaticResource ModernSecondaryButtonStyle}" DockPanel.Dock="Right" Width="80" Click="CloseBtn_Click" Margin="8,0,0,0" />
            <Button x:Name="ApplyBtn" Content="Apply to Selection" Style="{StaticResource ModernPrimaryButtonStyle}" DockPanel.Dock="Right" Width="150" Click="ApplyBtn_Click" />
        </DockPanel>
    </Grid>
</controls:BaseDialogWindow>
