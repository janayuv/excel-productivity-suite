<controls:BaseDialogWindow x:Class="ExcelProductivitySuite.UI.Dialogs.SplitWorkbookDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:ExcelProductivitySuite.UI.Controls"
        mc:Ignorable="d"
        Title="Split Workbook into Separate Files - Excel Productivity Suite"
        Height="540" Width="580"
        Background="#F8F9FA">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Brushes.xaml" />
                <ResourceDictionary Source="../Themes/Typography.xaml" />
                <ResourceDictionary Source="../Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{StaticResource BrandPrimaryBrush}" CornerRadius="4" Width="28" Height="28" Margin="0,0,10,0">
                    <TextBlock Text="📦" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel>
                    <TextBlock Text="Split Workbook into Separate Files" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Save each worksheet as an independent Excel (.xlsx), PDF (.pdf), or CSV file" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- Sheets List -->
        <GroupBox Grid.Row="1" Header="Worksheets to Export" Style="{StaticResource ModernGroupBoxStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="Select All" Style="{StaticResource ModernSecondaryButtonStyle}" Padding="8,2" Margin="0,0,8,0" Click="SelectAll_Click" />
                    <Button Content="Deselect All" Style="{StaticResource ModernSecondaryButtonStyle}" Padding="8,2" Click="DeselectAll_Click" />
                </StackPanel>

                <ListBox x:Name="SheetsListBox" Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="4,2" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </GroupBox>

        <!-- Options: Destination & Format -->
        <GroupBox Grid.Row="2" Header="Export Settings" Style="{StaticResource ModernGroupBoxStyle}" Margin="0,10,0,10">
            <StackPanel>
                <TextBlock Text="Destination Folder:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FolderBox" Grid.Column="0" Style="{StaticResource ModernTextBoxStyle}" />
                    <Button Content="Browse..." Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource ModernSecondaryButtonStyle}" Click="Browse_Click" />
                </Grid>

                <TextBlock Text="Export Format:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <RadioButton x:Name="XlsxRadio" Content="Excel Workbook (*.xlsx)" IsChecked="True" Style="{StaticResource ModernRadioButtonStyle}" Margin="0,0,16,0" />
                    <RadioButton x:Name="PdfRadio" Content="PDF Document (*.pdf)" Style="{StaticResource ModernRadioButtonStyle}" Margin="0,0,16,0" />
                    <RadioButton x:Name="CsvRadio" Content="CSV File (*.csv)" Style="{StaticResource ModernRadioButtonStyle}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Filename Pattern:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" />
                    <TextBox x:Name="PatternBox" Text="[SheetName]" Width="180" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,12,0" />
                    <TextBlock Text="(Tokens: [SheetName], [WorkbookName])" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" />
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- Actions -->
        <DockPanel Grid.Row="3">
            <TextBlock x:Name="StatusLabel" Text="Ready to export." VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="85" Height="28" Margin="0,0,8,0" Style="{StaticResource ModernSecondaryButtonStyle}" Click="Cancel_Click" />
                <Button Content="Split Workbook" Width="120" Height="28" Style="{StaticResource ModernPrimaryButtonStyle}" Click="Split_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</controls:BaseDialogWindow>
