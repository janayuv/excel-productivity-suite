<controls:BaseDialogWindow x:Class="ExcelProductivitySuite.UI.Dialogs.DatePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:ExcelProductivitySuite.UI.Controls"
        mc:Ignorable="d"
        Title="Date Picker - Excel Productivity Suite"
        Height="420" Width="560"
        Background="#F8F9FA">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Brushes.xaml" />
                <ResourceDictionary Source="../Themes/Typography.xaml" />
                <ResourceDictionary Source="../Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{StaticResource BrandPrimaryBrush}" CornerRadius="4" Width="28" Height="28" Margin="0,0,10,0">
                    <TextBlock Text="📅" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel>
                    <TextBlock Text="Date Picker Insertion" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Select a calendar date and insert formatted text into the active cell cursor" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- Main Body: Two Columns (Calendar on Left, Formatting on Right) -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Calendar Container -->
            <Border Grid.Column="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,10,0">
                <StackPanel HorizontalAlignment="Center">
                    <Calendar x:Name="CalendarControl" SelectedDatesChanged="Calendar_SelectedDatesChanged" Margin="0,0,0,6" />
                    <Button Content="Jump to Today" Style="{StaticResource ModernSecondaryButtonStyle}" Padding="8,4" HorizontalAlignment="Stretch" Click="Today_Click" />
                </StackPanel>
            </Border>

            <!-- Format Options & Preview -->
            <StackPanel Grid.Column="1">
                <GroupBox Header="Date Formatting" Style="{StaticResource ModernGroupBoxStyle}" Margin="0,0,0,10">
                    <StackPanel Margin="6">
                        <TextBlock Text="Format Preset:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
                        <ComboBox x:Name="FormatCombo" Style="{StaticResource ModernComboBoxStyle}" Margin="0,0,0,8" SelectionChanged="FormatCombo_SelectionChanged" />

                        <TextBlock Text="Custom Pattern:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
                        <TextBox x:Name="CustomFormatBox" Style="{StaticResource ModernTextBoxStyle}" Text="yyyy-MM-dd" TextChanged="CustomFormat_TextChanged" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Insertion Preview" Style="{StaticResource ModernGroupBoxStyle}">
                    <StackPanel Margin="8">
                        <TextBlock Text="Target Cell:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock x:Name="TargetCellText" Text="$A$1 (Active Sheet)" FontWeight="SemiBold" FontSize="11" Margin="0,1,0,6" />

                        <TextBlock Text="Formatted Value to Insert:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock x:Name="PreviewText" Text="2026-10-28" FontSize="16" FontWeight="Bold" Foreground="#0078D4" FontFamily="Consolas" Margin="0,2,0,0" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </Grid>

        <!-- Footer Actions -->
        <DockPanel Grid.Row="2">
            <Button Content="Cancel" Style="{StaticResource ModernSecondaryButtonStyle}" DockPanel.Dock="Right" Width="80" Click="Cancel_Click" />
            <Button Content="Insert Date" Style="{StaticResource ModernPrimaryButtonStyle}" DockPanel.Dock="Right" Width="110" Margin="0,0,8,0" Click="InsertDate_Click" />
        </DockPanel>
    </Grid>
</controls:BaseDialogWindow>
