<controls:BaseDialogWindow x:Class="ExcelProductivitySuite.UI.Dialogs.PrintMultipleWorkbooksDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ExcelProductivitySuite.UI.Controls"
        Title="Print Multiple Workbooks Wizard - Excel Productivity Suite"
        Height="620" Width="780"
        MinHeight="550" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        Background="#F8F9FA">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Brushes.xaml" />
                <ResourceDictionary Source="../Themes/Typography.xaml" />
                <ResourceDictionary Source="../Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <!-- Wizard Header -->
            <RowDefinition Height="Auto" />
            <!-- Stepper Indicator -->
            <RowDefinition Height="Auto" />
            <!-- Wizard Content Step Area -->
            <RowDefinition Height="*" />
            <!-- Progress Bar Area -->
            <RowDefinition Height="Auto" />
            <!-- Navigation Footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{StaticResource BrandPrimaryBrush}" CornerRadius="4" Width="32" Height="32" Margin="0,0,10,0">
                    <TextBlock Text="🖨️" Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel>
                    <TextBlock Text="Print Multiple Workbooks Wizard" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Batch print multiple Excel workbooks, specified worksheets, or CSV files across folders" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- STEPPER INDICATOR -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="Step1Badge" Grid.Column="0" Background="#EFF6FF" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="3" Padding="6,4" Margin="2,0">
                    <TextBlock Text="1. Directory &amp; Types" FontSize="11" FontWeight="Bold" Foreground="#1D4ED8" HorizontalAlignment="Center" />
                </Border>
                <Border x:Name="Step2Badge" Grid.Column="1" Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="3" Padding="6,4" Margin="2,0">
                    <TextBlock Text="2. Select Files" FontSize="11" FontWeight="SemiBold" Foreground="#4B5563" HorizontalAlignment="Center" />
                </Border>
                <Border x:Name="Step3Badge" Grid.Column="2" Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="3" Padding="6,4" Margin="2,0">
                    <TextBlock Text="3. Print Content" FontSize="11" FontWeight="SemiBold" Foreground="#4B5563" HorizontalAlignment="Center" />
                </Border>
                <Border x:Name="Step4Badge" Grid.Column="3" Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="3" Padding="6,4" Margin="2,0">
                    <TextBlock Text="4. Options &amp; Print" FontSize="11" FontWeight="SemiBold" Foreground="#4B5563" HorizontalAlignment="Center" />
                </Border>
            </Grid>
        </Border>

        <!-- WIZARD STEP PAGES CONTAINER -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <!-- STEP 1: DIRECTORY & FILE TYPES -->
            <Grid x:Name="Step1Panel" Visibility="Visible">
                <StackPanel>
                    <GroupBox Header="Step 1: File Location Strategy" Style="{StaticResource ModernGroupBoxStyle}" Margin="0,0,0,10">
                        <StackPanel Margin="6">
                            <RadioButton x:Name="RbSameDir" Content="All of the files to be printed are in the same directory" IsChecked="True" Checked="FolderMode_Changed" Margin="0,4" />
                            <RadioButton x:Name="RbMultiDir" Content="The files to be printed are located in different directories" Checked="FolderMode_Changed" Margin="0,4" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Select Folder Directory" Style="{StaticResource ModernGroupBoxStyle}" Margin="0,0,0,10">
                        <StackPanel Margin="6">
                            <DockPanel Margin="0,4">
                                <Button Content="Browse..." Width="90" Style="{StaticResource ModernSecondaryButtonStyle}" DockPanel.Dock="Right" Margin="8,0,0,0" Click="BrowseFolder_Click" />
                                <TextBox x:Name="FolderPathBox" Style="{StaticResource ModernTextBoxStyle}" Text="" />
                            </DockPanel>
                            <CheckBox x:Name="SubfoldersCheck" Content="Include files in subfolders (Recursive search)" IsChecked="False" Margin="0,6,0,0" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="File Formats &amp; Types" Style="{StaticResource ModernGroupBoxStyle}">
                        <StackPanel Margin="6">
                            <CheckBox x:Name="CheckExcelFiles" Content="Excel Workbooks (*.xlsx, *.xls, *.xlsm, *.xlsb)" IsChecked="True" Margin="0,4" />
                            <CheckBox x:Name="CheckCsvFiles" Content="CSV Delimited Files (*.csv)" IsChecked="False" Margin="0,4" />
                            <CheckBox x:Name="CheckTextFiles" Content="Text Files (*.txt, *.prn)" IsChecked="False" Margin="0,4" />
                            <DockPanel Margin="0,8,0,2">
                                <TextBlock Text="Custom Filter (e.g. *.xlsx;*.csv):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox x:Name="CustomFilterBox" Style="{StaticResource ModernTextBoxStyle}" Width="180" />
                            </DockPanel>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </Grid>

            <!-- STEP 2: FILE LIST & SELECTION -->
            <Grid x:Name="Step2Panel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Actions Toolbar -->
                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <Button Content="Add Files..." Style="{StaticResource ModernSecondaryButtonStyle}" Width="95" Margin="0,0,6,0" Click="AddFiles_Click" />
                    <Button Content="Add Folder..." Style="{StaticResource ModernSecondaryButtonStyle}" Width="100" Margin="0,0,6,0" Click="AddFolder_Click" />
                    <Button Content="Remove" Style="{StaticResource ModernSecondaryButtonStyle}" Width="80" Margin="0,0,6,0" Click="RemoveFiles_Click" />
                    <Button Content="Clear All" Style="{StaticResource ModernSecondaryButtonStyle}" Width="80" Margin="0,0,6,0" Click="ClearFiles_Click" />
                    <Button Content="Scan / Refresh" Style="{StaticResource ModernSecondaryButtonStyle}" Width="105" DockPanel.Dock="Right" Click="ScanRefresh_Click" />
                </DockPanel>

                <!-- Files ListView -->
                <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4">
                    <ListView x:Name="FilesListView" SelectionMode="Extended" BorderThickness="0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="40">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="File Name" Width="200" DisplayMemberBinding="{Binding FileName}" />
                                <GridViewColumn Header="Directory" Width="280" DisplayMemberBinding="{Binding Directory}" />
                                <GridViewColumn Header="Size" Width="80" DisplayMemberBinding="{Binding FileSizeFormatted}" />
                                <GridViewColumn Header="Last Modified" Width="130" DisplayMemberBinding="{Binding LastModified, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>

                <!-- Step 2 Summary -->
                <DockPanel Grid.Row="2" Margin="0,6,0,0">
                    <Button Content="Select All" Style="{StaticResource ModernSecondaryButtonStyle}" Width="90" Margin="0,0,6,0" Click="SelectAll_Click" />
                    <Button Content="Deselect All" Style="{StaticResource ModernSecondaryButtonStyle}" Width="95" Click="DeselectAll_Click" />
                    <TextBlock x:Name="FileCountSummaryText" Text="0 file(s) found, 0 selected" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </DockPanel>
            </Grid>

            <!-- STEP 3: PRINT CONTENTS & SHEET SCOPE -->
            <Grid x:Name="Step3Panel" Visibility="Collapsed">
                <StackPanel>
                    <GroupBox Header="Step 3: What to Print in Each Workbook" Style="{StaticResource ModernGroupBoxStyle}" Margin="0,0,0,10">
                        <StackPanel Margin="6">
                            <RadioButton x:Name="RbScopeEntire" Content="Print entire workbooks completely" IsChecked="True" Checked="Scope_Changed" Margin="0,4" />
                            <RadioButton x:Name="RbScopeWorksheetsOnly" Content="Print worksheets only (Exclude chart sheets)" Checked="Scope_Changed" Margin="0,4" />
                            <RadioButton x:Name="RbScopeChartSheetsOnly" Content="Print Chart sheets only" Checked="Scope_Changed" Margin="0,4" />
                            <RadioButton x:Name="RbScopeWorksheetsAndCharts" Content="Print worksheets and Chart sheets together" Checked="Scope_Changed" Margin="0,4" />
                            <RadioButton x:Name="RbScopeSpecific" Content="Print specific worksheets:" Checked="Scope_Changed" Margin="0,4" />

                            <StackPanel x:Name="SpecificSheetsPanel" Margin="22,4,0,4" IsEnabled="False">
                                <TextBlock Text="Enter worksheet names separated by commas or semicolons (supports * wildcards):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBox x:Name="SpecificSheetsBox" Style="{StaticResource ModernTextBoxStyle}" Text="Sheet1, Summary, Report*" Height="48" AcceptsReturn="True" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Page Range &amp; Copies" Style="{StaticResource ModernGroupBoxStyle}">
                        <StackPanel Margin="6">
                            <RadioButton x:Name="RbPageAll" Content="All pages" IsChecked="True" Checked="PageRange_Changed" Margin="0,4" />
                            <RadioButton x:Name="RbPageFirst" Content="Print first page of each sheet only (Cover pages)" Checked="PageRange_Changed" Margin="0,4" />
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <RadioButton x:Name="RbPageCustom" Content="Pages from:" Checked="PageRange_Changed" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox x:Name="FromPageBox" Text="1" Width="50" Style="{StaticResource ModernTextBoxStyle}" VerticalAlignment="Center" Margin="0,0,8,0" IsEnabled="False" />
                                <TextBlock Text="to:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox x:Name="ToPageBox" Text="1" Width="50" Style="{StaticResource ModernTextBoxStyle}" VerticalAlignment="Center" IsEnabled="False" />
                            </StackPanel>

                            <DockPanel Margin="0,10,0,2">
                                <TextBlock Text="Number of Copies (1 - 99):" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBox x:Name="CopiesBox" Text="1" Width="50" Style="{StaticResource ModernTextBoxStyle}" HorizontalAlignment="Left" />
                            </DockPanel>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </Grid>

            <!-- STEP 4: OPTIONS, PRINTER & FINISH -->
            <Grid x:Name="Step4Panel" Visibility="Collapsed">
                <StackPanel>
                    <GroupBox Header="Destination Printer" Style="{StaticResource ModernGroupBoxStyle}" Margin="0,0,0,10">
                        <StackPanel Margin="6">
                            <TextBlock Text="Select target Windows printer (or choose default):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <ComboBox x:Name="PrintersComboBox" Style="{StaticResource ModernComboBoxStyle}" Height="30" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Execution &amp; Safety Settings" Style="{StaticResource ModernGroupBoxStyle}" Margin="0,0,0,10">
                        <StackPanel Margin="6">
                            <CheckBox x:Name="CheckQuietMode" Content="Quiet Mode: Print in background without opening workbooks visually" IsChecked="True" Margin="0,4" />
                            <CheckBox x:Name="CheckDisableMacros" Content="Disable automatic macros when opening workbooks" IsChecked="True" Margin="0,4" />
                            <CheckBox x:Name="CheckDoNotUpdateLinks" Content="Do not update external links or remote references" IsChecked="True" Margin="0,4" />
                            <CheckBox x:Name="CheckGenerateReport" Content="Generate a summary report worksheet upon completion" IsChecked="True" Margin="0,4" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Ready to Print" Style="{StaticResource ModernGroupBoxStyle}">
                        <StackPanel Margin="6">
                            <TextBlock x:Name="ReadySummaryText" Text="Review your settings above. Click 'Start Printing' to execute the batch print operation." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- PROGRESS BAR AREA -->
        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <ProgressBar x:Name="BatchProgressBar" Height="8" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" Margin="0,0,0,4" />
            <TextBlock x:Name="StatusProgressText" Text="" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Visibility="Collapsed" />
        </StackPanel>

        <!-- FOOTER NAVIGATION -->
        <DockPanel Grid.Row="4">
            <Button Content="Close" Style="{StaticResource ModernSecondaryButtonStyle}" DockPanel.Dock="Right" Width="80" IsCancel="True" Click="Cancel_Click" />
            <Button x:Name="FinishButton" Content="Start Printing" Style="{StaticResource ModernPrimaryButtonStyle}" DockPanel.Dock="Right" Width="130" Margin="0,0,8,0" Visibility="Collapsed" Click="Finish_Click" />
            <Button x:Name="NextButton" Content="Next &gt;" Style="{StaticResource ModernPrimaryButtonStyle}" DockPanel.Dock="Right" Width="90" Margin="0,0,8,0" Click="Next_Click" />
            <Button x:Name="BackButton" Content="&lt; Back" Style="{StaticResource ModernSecondaryButtonStyle}" DockPanel.Dock="Right" Width="90" Margin="0,0,8,0" IsEnabled="False" Click="Back_Click" />
            <TextBlock x:Name="StepFooterText" Text="Step 1 of 4: Specify source folder and file formats" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</controls:BaseDialogWindow>
