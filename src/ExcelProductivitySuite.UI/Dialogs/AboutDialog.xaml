<controls:BaseDialogWindow x:Class="ExcelProductivitySuite.UI.Dialogs.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:ExcelProductivitySuite.UI.Controls"
        mc:Ignorable="d"
        Title="About Excel Productivity Suite"
        Height="420" Width="520"
        Background="#F8F9FA">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Brushes.xaml" />
                <ResourceDictionary Source="../Themes/Typography.xaml" />
                <ResourceDictionary Source="../Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Brand Header -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,16">
            <Border Background="{StaticResource BrandPrimaryBrush}" CornerRadius="12" Width="52" Height="52" HorizontalAlignment="Center" Margin="0,0,0,10">
                <TextBlock Text="⚡" Foreground="White" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Excel Productivity Suite" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="Version 1.0.0 • Professional Edition" FontSize="12" Foreground="{StaticResource BrandPrimaryBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0" />
        </StackPanel>

        <!-- System Details Card -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
            <StackPanel>
                <TextBlock Text="Environment &amp; Runtime Information" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Host Application:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Microsoft Excel (64-bit)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Runtime Framework:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text=".NET Framework 4.8 / VSTO 4.0" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="UI Technology:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="WPF / XAML (High-DPI Per-Monitor v2)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Automation Safety:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="In-Memory 2D Matrix COM Optimization" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Telemetry &amp; Privacy:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="Zero Cloud Uploads • 100% Local Processing" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource StatusSuccessBrush}" Margin="0,2" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Text="© Excel Productivity Suite. All rights reserved." VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource TextDisabledBrush}" />
            <Button Content="Close" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" Click="CloseButton_Click" IsCancel="True" IsDefault="True" />
        </DockPanel>
    </Grid>
</controls:BaseDialogWindow>
