<controls:BaseDialogWindow x:Class="ExcelProductivitySuite.UI.Dialogs.DeleteBlankSheetsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:ExcelProductivitySuite.UI.Controls"
        mc:Ignorable="d"
        Title="Delete Blank Worksheets - Excel Productivity Suite"
        Height="440" Width="520"
        Background="#F8F9FA">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Brushes.xaml" />
                <ResourceDictionary Source="../Themes/Typography.xaml" />
                <ResourceDictionary Source="../Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#D32F2F" CornerRadius="4" Width="28" Height="28" Margin="0,0,10,0">
                    <TextBlock Text="🗑" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel>
                    <TextBlock Text="Delete Blank Worksheets" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Safely scan and batch remove worksheets with empty UsedRanges and zero objects" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- Blank Sheets List -->
        <GroupBox Grid.Row="1" Header="Blank Worksheets Detected" Style="{StaticResource ModernGroupBoxStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="Select All" Style="{StaticResource ModernSecondaryButtonStyle}" Padding="8,2" Margin="0,0,8,0" Click="SelectAll_Click" />
                    <Button Content="Deselect All" Style="{StaticResource ModernSecondaryButtonStyle}" Padding="8,2" Click="DeselectAll_Click" />
                </StackPanel>

                <ListBox x:Name="BlankSheetsListBox" Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="4,2" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="NoBlanksNotice" Grid.Row="1" Text="No completely blank worksheets were found." FontStyle="Italic" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>
        </GroupBox>

        <!-- Actions -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="StatusLabel" Text="Caution: Sheet deletion cannot be undone by Excel Undo." VerticalAlignment="Center" FontSize="10" Foreground="#C62828" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="85" Height="28" Margin="0,0,8,0" Style="{StaticResource ModernSecondaryButtonStyle}" Click="Cancel_Click" />
                <Button x:Name="DeleteButton" Content="Delete Blank Sheets" Width="140" Height="28" Background="#D32F2F" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Click="Delete_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</controls:BaseDialogWindow>
