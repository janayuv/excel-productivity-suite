<controls:BaseDialogWindow x:Class="ExcelProductivitySuite.UI.Dialogs.SortSheetTabsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:ExcelProductivitySuite.UI.Controls"
        mc:Ignorable="d"
        Title="Sort Worksheet Tabs - Excel Productivity Suite"
        Height="480" Width="550"
        Background="#F8F9FA">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Brushes.xaml" />
                <ResourceDictionary Source="../Themes/Typography.xaml" />
                <ResourceDictionary Source="../Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{StaticResource BrandPrimaryBrush}" CornerRadius="4" Width="28" Height="28" Margin="0,0,10,0">
                    <TextBlock Text="🔤" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel>
                    <TextBlock Text="Sort Worksheet Tabs" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Reorder worksheet tabs alphabetically, naturally by numeric values, or reversed" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- Sort Mode Selection -->
        <GroupBox Grid.Row="1" Header="Tab Sort Order" Style="{StaticResource ModernGroupBoxStyle}">
            <StackPanel>
                <RadioButton x:Name="NaturalNumericRadio" Content="Natural Numeric Order (e.g., Sheet1, Sheet2, Sheet10)" IsChecked="True" Style="{StaticResource ModernRadioButtonStyle}" Checked="SortMode_Changed" />
                <RadioButton x:Name="AlphaAscRadio" Content="Alphabetical Ascending (A to Z)" Style="{StaticResource ModernRadioButtonStyle}" Checked="SortMode_Changed" />
                <RadioButton x:Name="AlphaDescRadio" Content="Alphabetical Descending (Z to A)" Style="{StaticResource ModernRadioButtonStyle}" Checked="SortMode_Changed" />
                <RadioButton x:Name="ReverseRadio" Content="Reverse Current Tab Order" Style="{StaticResource ModernRadioButtonStyle}" Checked="SortMode_Changed" />
            </StackPanel>
        </GroupBox>

        <!-- Preview Grid: Current vs Preview -->
        <GroupBox Grid.Row="2" Header="Tab Order Preview" Style="{StaticResource ModernGroupBoxStyle}" Margin="0,10,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0">
                    <TextBlock Text="Current Tab Order" FontWeight="SemiBold" FontSize="11" DockPanel.Dock="Top" Margin="0,0,0,4" />
                    <ListBox x:Name="CurrentOrderListBox" Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" />
                </DockPanel>

                <TextBlock Grid.Column="1" Text="➔" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />

                <DockPanel Grid.Column="2">
                    <TextBlock Text="New Sorted Order" FontWeight="SemiBold" FontSize="11" DockPanel.Dock="Top" Margin="0,0,0,4" />
                    <ListBox x:Name="PreviewOrderListBox" Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" />
                </DockPanel>
            </Grid>
        </GroupBox>

        <!-- Actions -->
        <DockPanel Grid.Row="3">
            <TextBlock x:Name="SummaryLabel" Text="4 tabs will be reordered." VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="85" Height="28" Margin="0,0,8,0" Style="{StaticResource ModernSecondaryButtonStyle}" Click="Cancel_Click" />
                <Button Content="Sort Tabs" Width="100" Height="28" Style="{StaticResource ModernPrimaryButtonStyle}" Click="ApplySort_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</controls:BaseDialogWindow>
