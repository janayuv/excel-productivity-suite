<controls:BaseDialogWindow x:Class="ExcelProductivitySuite.UI.Dialogs.CompareRangesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:ExcelProductivitySuite.UI.Controls"
        mc:Ignorable="d"
        Title="Compare Ranges - Excel Productivity Suite"
        Height="580" Width="680"
        Background="#F8F9FA">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Brushes.xaml" />
                <ResourceDictionary Source="../Themes/Typography.xaml" />
                <ResourceDictionary Source="../Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="Auto" /> <!-- Ranges Input -->
            <RowDefinition Height="Auto" /> <!-- Comparison Mode & Options -->
            <RowDefinition Height="*" />    <!-- Discrepancy Table -->
            <RowDefinition Height="Auto" /> <!-- Summary & Footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{StaticResource BrandPrimaryBrush}" CornerRadius="4" Width="28" Height="28" Margin="0,0,10,0">
                    <TextBlock Text="⚖" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel>
                    <TextBlock Text="Compare Ranges / Datasets" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Identify discrepancies, missing values, and cell mismatches between two ranges" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- Range Inputs -->
        <GroupBox Grid.Row="1" Header="Ranges to Compare" Style="{StaticResource ModernGroupBoxStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Source Range (Active Selection):" FontSize="12" Margin="0,0,0,3" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBox x:Name="SourceRangeTextBox" Style="{StaticResource ModernTextBoxStyle}" IsReadOnly="True" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="Target Range Address (e.g. B1:B20 or Sheet2!A1:A20):" FontSize="12" Margin="0,0,0,3" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBox x:Name="TargetRangeTextBox" Style="{StaticResource ModernTextBoxStyle}" TextChanged="TargetRange_TextChanged" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Mode & Options -->
        <GroupBox Grid.Row="2" Header="Comparison Criteria" Style="{StaticResource ModernGroupBoxStyle}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <RadioButton x:Name="ModeCellByCellRadio" Content="Cell-by-cell (Same position)" IsChecked="True" Style="{StaticResource ModernRadioButtonStyle}" Margin="0,0,16,0" Checked="OptionChanged" />
                    <RadioButton x:Name="ModeMissingInTargetRadio" Content="Values in Source not in Target" Style="{StaticResource ModernRadioButtonStyle}" Margin="0,0,16,0" Checked="OptionChanged" />
                    <RadioButton x:Name="ModeCommonRadio" Content="Common (Matching) Values" Style="{StaticResource ModernRadioButtonStyle}" Checked="OptionChanged" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <CheckBox x:Name="MatchCaseCheckBox" Content="Match case" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,16,0" Checked="OptionChanged" Unchecked="OptionChanged" />
                    <CheckBox x:Name="TrimWhitespaceCheckBox" Content="Trim whitespace" IsChecked="True" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,16,0" Checked="OptionChanged" Unchecked="OptionChanged" />
                    <CheckBox x:Name="IgnoreEmptyCheckBox" Content="Ignore blank cells" IsChecked="True" Style="{StaticResource ModernCheckBoxStyle}" Checked="OptionChanged" Unchecked="OptionChanged" />
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- Discrepancy Table -->
        <GroupBox Grid.Row="3" Header="Discrepancies &amp; Comparison Output" Style="{StaticResource ModernGroupBoxStyle}" Margin="0,8,0,0">
            <DataGrid x:Name="DiscrepancyGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource BrandBorderBrush}"
                      BorderThickness="0"
                      Background="White"
                      RowHeaderWidth="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Cell" Binding="{Binding Description}" Width="160" />
                    <DataGridTextColumn Header="Source Value" Binding="{Binding SourceValue}" Width="*" />
                    <DataGridTextColumn Header="Target Value" Binding="{Binding TargetValue}" Width="*" />
                    <DataGridTextColumn Header="Discrepancy" Binding="{Binding DifferenceType}" Width="130" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- Summary & Footer -->
        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <TextBlock x:Name="SummaryText" Text="Specify target range address and click Compare." VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="CloseButton_Click" IsCancel="True" />
                <Button x:Name="CompareButton" Content="Run Comparison" Style="{StaticResource PrimaryButtonStyle}" Click="CompareButton_Click" IsDefault="True" />
            </StackPanel>
        </DockPanel>
    </Grid>
</controls:BaseDialogWindow>
