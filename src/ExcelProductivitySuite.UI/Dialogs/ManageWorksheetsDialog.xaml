<controls:BaseDialogWindow x:Class="ExcelProductivitySuite.UI.Dialogs.ManageWorksheetsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:ExcelProductivitySuite.UI.Controls"
        mc:Ignorable="d"
        Title="Worksheet Visibility Manager - Excel Productivity Suite"
        Height="480" Width="560"
        Background="#F8F9FA">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Brushes.xaml" />
                <ResourceDictionary Source="../Themes/Typography.xaml" />
                <ResourceDictionary Source="../Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{StaticResource BrandPrimaryBrush}" CornerRadius="4" Width="28" Height="28" Margin="0,0,10,0">
                    <TextBlock Text="👁" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel>
                    <TextBlock Text="Worksheet Visibility" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Manage Visible, Hidden, and VeryHidden worksheet states" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- Bulk Action Buttons -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,10">
            <DockPanel>
                <TextBlock Text="Quick Actions:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="4,0,10,0" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="Unhide All Sheets" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="UnhideAllButton_Click" />
                    <Button Content="Hide Inactive Sheets" Style="{StaticResource SecondaryButtonStyle}" Click="HideInactiveButton_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Sheets DataGrid -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="6">
            <DataGrid x:Name="SheetsGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#EAECEF"
                      RowBackground="#FFFFFF"
                      AlternatingRowBackground="#F8F9FA"
                      BorderThickness="0"
                      FontSize="12">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Visible" Binding="{Binding IsVisible, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                    <DataGridTextColumn Header="Worksheet Name" Binding="{Binding SheetName}" Width="*" IsReadOnly="True" FontWeight="SemiBold" />
                    <DataGridCheckBoxColumn Header="Very Hidden" Binding="{Binding IsVeryHidden, UpdateSourceTrigger=PropertyChanged}" Width="95" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer -->
        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="StatusInfoText" Text="At least one worksheet must remain visible." VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="CancelButton_Click" IsCancel="True" />
                <Button Content="Apply Changes" Style="{StaticResource PrimaryButtonStyle}" Click="ApplyButton_Click" IsDefault="True" />
            </StackPanel>
        </DockPanel>
    </Grid>
</controls:BaseDialogWindow>
