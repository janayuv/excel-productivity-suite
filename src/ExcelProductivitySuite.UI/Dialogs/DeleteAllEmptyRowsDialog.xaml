<controls:BaseDialogWindow x:Class="ExcelProductivitySuite.UI.Dialogs.DeleteAllEmptyRowsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:ExcelProductivitySuite.UI.Controls"
        mc:Ignorable="d"
        Title="Delete All Empty Rows - ASAP Utilities #232"
        Height="520" Width="580"
        WindowStartupLocation="CenterScreen"
        Background="#F8F9FA">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Brushes.xaml" />
                <ResourceDictionary Source="../Themes/Typography.xaml" />
                <ResourceDictionary Source="../Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#D32F2F" CornerRadius="6" Width="36" Height="36" Margin="0,0,12,0">
                    <TextBlock Text="✕" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Delete All Empty Rows" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <Border Background="#E3F2FD" CornerRadius="3" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ASAP Utilities #232" FontSize="10" FontWeight="Bold" Foreground="#1976D2" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Removes completely empty rows within the dataset on your worksheet, eliminating gaps." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- Scope Selection -->
        <GroupBox Grid.Row="1" Header="Scan &amp; Deletion Scope" Style="{StaticResource ModernGroupBoxStyle}" Margin="0,0,0,10">
            <StackPanel Margin="4,4,4,4">
                <RadioButton x:Name="ScopeActiveSheetRadio" 
                             Content="Active Worksheet (Entire Dataset / Used Range)" 
                             IsChecked="True" 
                             Style="{StaticResource ModernRadioButtonStyle}" 
                             Checked="OptionChanged" />
                <RadioButton x:Name="ScopeSelectionRadio" 
                             Content="Current Selection Only" 
                             Style="{StaticResource ModernRadioButtonStyle}" 
                             Margin="0,4,0,0"
                             Checked="OptionChanged" />
                <RadioButton x:Name="ScopeAllSheetsRadio" 
                             Content="All Worksheets in Active Workbook" 
                             Style="{StaticResource ModernRadioButtonStyle}" 
                             Margin="0,4,0,0"
                             Checked="OptionChanged" />
            </StackPanel>
        </GroupBox>

        <!-- Options -->
        <GroupBox Grid.Row="2" Header="Detection Criteria" Style="{StaticResource ModernGroupBoxStyle}" Margin="0,0,0,10">
            <StackPanel Margin="4,4,4,4">
                <CheckBox x:Name="ChkTreatWhitespace" 
                          Content="Treat cells containing only whitespace / spaces as empty" 
                          IsChecked="True" 
                          Margin="0,2"
                          Checked="OptionChanged" 
                          Unchecked="OptionChanged" />
                <CheckBox x:Name="ChkTreatEmptyFormulas" 
                          Content="Treat formulas evaluating to empty text (&quot;&quot;) or null as empty" 
                          IsChecked="True" 
                          Margin="0,2"
                          Checked="OptionChanged" 
                          Unchecked="OptionChanged" />
            </StackPanel>
        </GroupBox>

        <!-- Pre-Scan Summary & Impact Card -->
        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <DockPanel LastChildFill="True">
                        <TextBlock x:Name="StatusBadge" Text="●" Foreground="#2E7D32" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="ScanSummaryHeader" Text="Scanning worksheet dataset..." FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </DockPanel>

                    <TextBlock x:Name="ScanDetailsText" Text="Please wait while rows are inspected..." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="22,4,0,0" TextWrapping="Wrap" />

                    <Separator Margin="0,10,0,10" Background="{StaticResource BorderLightBrush}" />

                    <Grid Margin="22,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Empty Rows to Delete:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock x:Name="EmptyCountText" Text="0" FontSize="18" FontWeight="Bold" Foreground="#D32F2F" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Data Rows Remaining:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock x:Name="RemainingCountText" Text="0" FontSize="18" FontWeight="Bold" Foreground="#2E7D32" />
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="RangeBreakdownText" Text="" FontSize="11" Foreground="{StaticResource BrandPrimaryBrush}" Margin="22,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Footer -->
        <DockPanel Grid.Row="4">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Fast batch deletion • Order-independent shift upward" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Width="90" Height="30" Margin="0,0,10,0" Click="CancelButton_Click" IsCancel="True" />
                <Button x:Name="DeleteButton" Content="Delete All Empty Rows" Width="170" Height="30" Background="#D32F2F" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Click="DeleteButton_Click" IsDefault="True" />
            </StackPanel>
        </DockPanel>
    </Grid>
</controls:BaseDialogWindow>
