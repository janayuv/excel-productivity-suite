<controls:BaseDialogWindow x:Class="ExcelProductivitySuite.UI.Dialogs.BatchRenameWorksheetsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:ExcelProductivitySuite.UI.Controls"
        mc:Ignorable="d"
        Title="Batch Rename Worksheets - Excel Productivity Suite"
        Height="540" Width="640"
        Background="#F8F9FA">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Brushes.xaml" />
                <ResourceDictionary Source="../Themes/Typography.xaml" />
                <ResourceDictionary Source="../Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{StaticResource BrandPrimaryBrush}" CornerRadius="4" Width="28" Height="28" Margin="0,0,10,0">
                    <TextBlock Text="🏷" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel>
                    <TextBlock Text="Rename Worksheets in Bulk" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Rename multiple sheets simultaneously with prefix, suffix, and sequence rules" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- Configuration -->
        <GroupBox Grid.Row="1" Header="Renaming Rules" Style="{StaticResource ModernGroupBoxStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,6">
                    <TextBlock Text="Prefix to prepend:" FontSize="12" Margin="0,0,0,3" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBox x:Name="PrefixTextBox" Style="{StaticResource ModernTextBoxStyle}" TextChanged="OptionChanged" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,6">
                    <TextBlock Text="Suffix to append:" FontSize="12" Margin="0,0,0,3" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBox x:Name="SuffixTextBox" Style="{StaticResource ModernTextBoxStyle}" TextChanged="OptionChanged" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,6">
                    <TextBlock Text="Find text:" FontSize="12" Margin="0,0,0,3" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBox x:Name="FindTextBox" Style="{StaticResource ModernTextBoxStyle}" TextChanged="OptionChanged" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,6">
                    <TextBlock Text="Replace with:" FontSize="12" Margin="0,0,0,3" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBox x:Name="ReplaceTextBox" Style="{StaticResource ModernTextBoxStyle}" TextChanged="OptionChanged" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4,0,0">
                    <CheckBox x:Name="SequenceCheckBox" Content="Append sequential numbers (e.g. _01, _02)" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,16,0" Checked="OptionChanged" Unchecked="OptionChanged" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Preview Grid -->
        <DockPanel Grid.Row="2" Margin="0,8,0,0">
            <TextBlock DockPanel.Dock="Top" Text="Proposed Sheet Names Preview:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
            <Border Background="White" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="6">
                <DataGrid x:Name="PreviewGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#EAECEF"
                          RowBackground="#FFFFFF"
                          AlternatingRowBackground="#F8F9FA"
                          BorderThickness="0"
                          FontSize="12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Original Sheet Name" Binding="{Binding Original}" Width="*" />
                        <DataGridTextColumn Header="New Sheet Name" Binding="{Binding Result}" Width="*" FontWeight="SemiBold" Foreground="#107C41" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>

        <!-- Footer -->
        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="ValidationStatusText" Text="Validates against Excel 31-character limit and character rules" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="CancelButton_Click" IsCancel="True" />
                <Button Content="Rename All Sheets" Style="{StaticResource PrimaryButtonStyle}" Click="ApplyButton_Click" IsDefault="True" />
            </StackPanel>
        </DockPanel>
    </Grid>
</controls:BaseDialogWindow>
