<controls:BaseDialogWindow x:Class="ExcelProductivitySuite.UI.Dialogs.CopyPageSetupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:ExcelProductivitySuite.UI.Controls"
        mc:Ignorable="d"
        Title="Copy Page Setup - Excel Productivity Suite"
        Height="520" Width="520"
        Background="#F8F9FA">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Brushes.xaml" />
                <ResourceDictionary Source="../Themes/Typography.xaml" />
                <ResourceDictionary Source="../Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{StaticResource BrandPrimaryBrush}" CornerRadius="4" Width="28" Height="28" Margin="0,0,10,0">
                    <TextBlock Text="🖨️" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel>
                    <TextBlock Text="Copy Page Setup" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Copy page layout, print titles, margins, and headers/footers to other worksheets" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- Source Worksheet -->
        <GroupBox Grid.Row="1" Header="Source Worksheet" Style="{StaticResource ModernGroupBoxStyle}">
            <DockPanel Margin="4">
                <TextBlock Text="Copy page setup from:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" />
                <ComboBox x:Name="SourceSheetCombo" Style="{StaticResource ModernComboBoxStyle}" SelectionChanged="SourceSheet_SelectionChanged" />
            </DockPanel>
        </GroupBox>

        <!-- Target Worksheets -->
        <GroupBox Grid.Row="2" Header="Target Worksheets" Style="{StaticResource ModernGroupBoxStyle}" Margin="0,10,0,10">
            <Grid Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock Text="Select destination worksheets:" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Select All" Width="70" Margin="0,0,6,0" Style="{StaticResource ModernSecondaryButtonStyle}" Click="SelectAll_Click" />
                        <Button Content="Deselect All" Width="80" Style="{StaticResource ModernSecondaryButtonStyle}" Click="DeselectAll_Click" />
                    </StackPanel>
                </DockPanel>
                <ListBox x:Name="TargetSheetsList" Grid.Row="1" BorderBrush="#DEE2E6" BorderThickness="1" Background="White" MaxHeight="140">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Style="{StaticResource ModernCheckBoxStyle}" Margin="2" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </GroupBox>

        <!-- Page Setup Options -->
        <GroupBox Grid.Row="3" Header="Page Setup Settings to Copy" Style="{StaticResource ModernGroupBoxStyle}" Margin="0,0,0,12">
            <Grid Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <CheckBox x:Name="OrientationCheck" Grid.Row="0" Grid.Column="0" Content="Orientation &amp; Paper Size" IsChecked="True" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,6" />
                <CheckBox x:Name="MarginsCheck" Grid.Row="0" Grid.Column="1" Content="Margins (Top, Bottom, etc.)" IsChecked="True" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,6" />
                <CheckBox x:Name="PrintTitlesCheck" Grid.Row="1" Grid.Column="0" Content="Print Titles (Repeat Rows/Cols)" IsChecked="True" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,6" />
                <CheckBox x:Name="ScalingCheck" Grid.Row="1" Grid.Column="1" Content="Scaling &amp; Fit to Pages" IsChecked="True" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,6" />
                <CheckBox x:Name="HeadersCheck" Grid.Row="2" Grid.Column="0" Content="Headers &amp; Footers" IsChecked="True" Style="{StaticResource ModernCheckBoxStyle}" />
                <CheckBox x:Name="SheetOptionsCheck" Grid.Row="2" Grid.Column="1" Content="Print Gridlines &amp; Centering" IsChecked="True" Style="{StaticResource ModernCheckBoxStyle}" />
            </Grid>
        </GroupBox>

        <!-- Footer / Action Buttons -->
        <DockPanel Grid.Row="4">
            <TextBlock x:Name="StatusLabel" Text="Ready" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Copy Setup" Width="110" Margin="0,0,8,0" Style="{StaticResource ModernPrimaryButtonStyle}" Click="CopySetup_Click" />
                <Button Content="Close" Width="75" Style="{StaticResource ModernSecondaryButtonStyle}" Click="Close_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</controls:BaseDialogWindow>
