<controls:BaseDialogWindow x:Class="ExcelProductivitySuite.UI.Dialogs.ClearValidationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:ExcelProductivitySuite.UI.Controls"
        mc:Ignorable="d"
        Title="Clear Data Validation Rules - Excel Productivity Suite"
        Height="360" Width="480"
        Background="#F8F9FA">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Brushes.xaml" />
                <ResourceDictionary Source="../Themes/Typography.xaml" />
                <ResourceDictionary Source="../Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{StaticResource BrandPrimaryBrush}" CornerRadius="4" Width="28" Height="28" Margin="0,0,10,0">
                    <TextBlock Text="🛡️" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel>
                    <TextBlock Text="Clear Data Validation Rules" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Remove dropdown arrows, constraints, and input messages safely" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- Scope Selection -->
        <GroupBox Grid.Row="1" Header="Validation Scope to Clear" Style="{StaticResource ModernGroupBoxStyle}">
            <StackPanel Margin="10">
                <RadioButton x:Name="SelectionRadio" Content="Selected Cells Only" IsChecked="True" Style="{StaticResource ModernRadioButtonStyle}" Margin="0,0,0,10" />
                <RadioButton x:Name="ActiveSheetRadio" Content="Active Worksheet (All Cells)" Style="{StaticResource ModernRadioButtonStyle}" Margin="0,0,0,10" />
                <RadioButton x:Name="AllSheetsRadio" Content="All Worksheets in Active Workbook" Style="{StaticResource ModernRadioButtonStyle}" Margin="0,0,0,14" />

                <Border Background="#EBF3FC" CornerRadius="4" Padding="10" BorderBrush="#BED6F6" BorderThickness="1">
                    <TextBlock Text="ℹ Note: Clearing validation rules removes list dropdowns and entry limits, but preserves all current cell values and cell formatting intact."
                               TextWrapping="Wrap" FontSize="11" Foreground="#1E429F" />
                </Border>
            </StackPanel>
        </GroupBox>

        <!-- Footer -->
        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="TargetInfoText" Text="Target: Active Selection" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource ModernSecondaryButtonStyle}" Margin="0,0,8,0" Click="CancelButton_Click" IsCancel="True" />
                <Button Content="Clear Validation" Style="{StaticResource ModernPrimaryButtonStyle}" Click="ApplyButton_Click" IsDefault="True" />
            </StackPanel>
        </DockPanel>
    </Grid>
</controls:BaseDialogWindow>
