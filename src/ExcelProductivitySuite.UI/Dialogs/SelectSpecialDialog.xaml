<controls:BaseDialogWindow x:Class="ExcelProductivitySuite.UI.Dialogs.SelectSpecialDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:ExcelProductivitySuite.UI.Controls"
        mc:Ignorable="d"
        Title="Select Special Cells - Excel Productivity Suite"
        Height="500" Width="580"
        Background="#F8F9FA">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Brushes.xaml" />
                <ResourceDictionary Source="../Themes/Typography.xaml" />
                <ResourceDictionary Source="../Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="Auto" /> <!-- Criteria Options -->
            <RowDefinition Height="*" />    <!-- Matching Cells Grid -->
            <RowDefinition Height="Auto" /> <!-- Summary & Footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{StaticResource BrandPrimaryBrush}" CornerRadius="4" Width="28" Height="28" Margin="0,0,10,0">
                    <TextBlock Text="🎯" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel>
                    <TextBlock Text="Select Special Cells" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Quickly identify, inspect, and select cells matching specific attributes" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="RangeInfoText" Text="Range: $A$1:$D$50" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
        </DockPanel>

        <!-- Criteria -->
        <GroupBox Grid.Row="1" Header="Selection Criteria" Style="{StaticResource ModernGroupBoxStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <RadioButton x:Name="RadioBlank" Content="Blank Cells" IsChecked="True" Style="{StaticResource ModernRadioButtonStyle}" Margin="0,0,0,6" Checked="CriteriaChanged" />
                    <RadioButton x:Name="RadioNonBlank" Content="Non-Blank / Constant Cells" Style="{StaticResource ModernRadioButtonStyle}" Margin="0,0,0,6" Checked="CriteriaChanged" />
                    <RadioButton x:Name="RadioErrors" Content="Error Cells (#N/A, #VALUE!, etc.)" Style="{StaticResource ModernRadioButtonStyle}" Margin="0,0,0,6" Checked="CriteriaChanged" />
                    <RadioButton x:Name="RadioFormulas" Content="Formula Cells" Style="{StaticResource ModernRadioButtonStyle}" Checked="CriteriaChanged" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <RadioButton x:Name="RadioNumeric" Content="Numeric Cells" Style="{StaticResource ModernRadioButtonStyle}" Margin="0,0,0,6" Checked="CriteriaChanged" />
                    <RadioButton x:Name="RadioText" Content="Text / Label Cells" Style="{StaticResource ModernRadioButtonStyle}" Margin="0,0,0,6" Checked="CriteriaChanged" />
                    <RadioButton x:Name="RadioMax" Content="Maximum Numeric Value" Style="{StaticResource ModernRadioButtonStyle}" Margin="0,0,0,6" Checked="CriteriaChanged" />
                    <RadioButton x:Name="RadioMin" Content="Minimum Numeric Value" Style="{StaticResource ModernRadioButtonStyle}" Checked="CriteriaChanged" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Matching Output -->
        <GroupBox Grid.Row="2" Header="Matching Cells Found" Style="{StaticResource ModernGroupBoxStyle}" Margin="0,8,0,0">
            <DataGrid x:Name="MatchingCellsGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource BrandBorderBrush}"
                      BorderThickness="0"
                      Background="White"
                      RowHeaderWidth="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Cell Address" Binding="{Binding Description}" Width="150" />
                    <DataGridTextColumn Header="Row" Binding="{Binding Row}" Width="80" />
                    <DataGridTextColumn Header="Column" Binding="{Binding Column}" Width="80" />
                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- Footer -->
        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="CountSummaryText" Text="Calculating..." VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="CloseButton_Click" IsCancel="True" />
                <Button x:Name="SelectInExcelButton" Content="Select First Matching" Style="{StaticResource PrimaryButtonStyle}" Click="SelectInExcelButton_Click" IsDefault="True" />
            </StackPanel>
        </DockPanel>
    </Grid>
</controls:BaseDialogWindow>
