<controls:BaseDialogWindow x:Class="ExcelProductivitySuite.UI.Dialogs.ExactCopyFormulaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:ExcelProductivitySuite.UI.Controls"
        mc:Ignorable="d"
        Title="Exact Copy Formulas - Excel Productivity Suite"
        Height="410" Width="460"
        Background="#F8F9FA">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Brushes.xaml" />
                <ResourceDictionary Source="../Themes/Typography.xaml" />
                <ResourceDictionary Source="../Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{StaticResource BrandPrimaryBrush}" CornerRadius="4" Width="28" Height="28" Margin="0,0,10,0">
                    <TextBlock Text="📑" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel>
                    <TextBlock Text="Exact Copy Formulas" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Copy formulas verbatim into new cells without adjusting relative references" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- Range Inputs -->
        <GroupBox Grid.Row="1" Header="Source &amp; Destination Ranges" Style="{StaticResource ModernGroupBoxStyle}">
            <StackPanel Margin="4">
                <TextBlock Text="Source Range (Formulas to Copy):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
                <TextBox x:Name="SourceRangeText" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,8" />

                <TextBlock Text="Destination Cell or Range (e.g. E1 or Sheet2!B5):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
                <TextBox x:Name="DestinationRangeText" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,4" />
            </StackPanel>
        </GroupBox>

        <!-- Copy Behavior -->
        <GroupBox Grid.Row="2" Header="Copy Options" Style="{StaticResource ModernGroupBoxStyle}" Margin="0,10,0,12">
            <StackPanel Margin="4">
                <RadioButton x:Name="ExactDimensionsRadio" Content="Match source dimensions at destination top-left" IsChecked="True" Style="{StaticResource ModernRadioButtonStyle}" Margin="0,0,0,6" />
                <TextBlock Text="Pastes formulas into identical row and column dimensions without shifting cell references." FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="20,-4,0,8" />

                <CheckBox x:Name="ConfirmOverwriteCheck" Content="Prompt before overwriting non-empty cells" IsChecked="True" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,4,0,0" />
            </StackPanel>
        </GroupBox>

        <!-- Footer / Action Buttons -->
        <DockPanel Grid.Row="3">
            <TextBlock x:Name="StatusLabel" Text="Ready" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Copy Verbatim" Width="120" Margin="0,0,8,0" Style="{StaticResource ModernPrimaryButtonStyle}" Click="Copy_Click" />
                <Button Content="Cancel" Width="75" Style="{StaticResource ModernSecondaryButtonStyle}" Click="Cancel_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</controls:BaseDialogWindow>
