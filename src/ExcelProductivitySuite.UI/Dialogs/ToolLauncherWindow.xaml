<controls:BaseDialogWindow x:Class="ExcelProductivitySuite.UI.Dialogs.ToolLauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:ExcelProductivitySuite.UI.Controls"
        mc:Ignorable="d"
        Title="Excel Productivity Suite - Tool Launcher"
        Height="540" Width="680"
        WindowStartupLocation="CenterOwner"
        Background="#F8F9FA"
        FocusManager.FocusedElement="{Binding ElementName=SearchTextBox}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Brushes.xaml" />
                <ResourceDictionary Source="../Themes/Typography.xaml" />
                <ResourceDictionary Source="../Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="Auto" /> <!-- Search Box -->
            <RowDefinition Height="Auto" /> <!-- Category Filter Tabs -->
            <RowDefinition Height="*" />    <!-- Commands List -->
            <RowDefinition Height="Auto" /> <!-- Footer Action Bar -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{StaticResource BrandPrimaryBrush}" CornerRadius="4" Width="28" Height="28" Margin="0,0,10,0">
                    <TextBlock Text="⚡" Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel>
                    <TextBlock Text="Quick Tool Launcher" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Search, browse, and instantly execute any suite utility" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
            <TextBlock Text="Press Enter to Run • Esc to Close" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextDisabledBrush}" />
        </DockPanel>

        <!-- Search Box -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="🔍" VerticalAlignment="Center" Margin="8,0,6,0" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBox Grid.Column="1" x:Name="SearchTextBox" BorderThickness="0" FontSize="14" VerticalAlignment="Center" TextChanged="SearchTextBox_TextChanged" PreviewKeyDown="SearchTextBox_PreviewKeyDown" />
                <Button Grid.Column="2" x:Name="ClearButton" Content="✕" Width="24" Height="24" Style="{StaticResource SecondaryButtonStyle}" Padding="0" Click="ClearButton_Click" ToolTip="Clear search" Visibility="Collapsed" />
            </Grid>
        </Border>

        <!-- Category Filters -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <RadioButton x:Name="CatAll" Content="All Tools" IsChecked="True" Checked="CategoryFilter_Checked" Style="{StaticResource ModernRadioButtonStyle}" Margin="0,0,12,0" FontWeight="SemiBold" />
            <RadioButton x:Name="CatText" Content="Text" Checked="CategoryFilter_Checked" Style="{StaticResource ModernRadioButtonStyle}" Margin="0,0,12,0" />
            <RadioButton x:Name="CatRange" Content="Range &amp; Cells" Checked="CategoryFilter_Checked" Style="{StaticResource ModernRadioButtonStyle}" Margin="0,0,12,0" />
            <RadioButton x:Name="CatCleaning" Content="Data Cleaning" Checked="CategoryFilter_Checked" Style="{StaticResource ModernRadioButtonStyle}" Margin="0,0,12,0" />
            <RadioButton x:Name="CatSheets" Content="Worksheets" Checked="CategoryFilter_Checked" Style="{StaticResource ModernRadioButtonStyle}" Margin="0,0,12,0" />
            <RadioButton x:Name="CatFormulas" Content="Formulas" Checked="CategoryFilter_Checked" Style="{StaticResource ModernRadioButtonStyle}" />
        </StackPanel>

        <!-- Commands List -->
        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="6">
            <ListBox x:Name="CommandsListBox" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="CommandsListBox_MouseDoubleClick" KeyDown="CommandsListBox_KeyDown">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="8,6" BorderBrush="{StaticResource SurfaceDividerBrush}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,8,0" />
                                        <Border Background="{StaticResource BrandLightBrush}" CornerRadius="3" Padding="6,1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{StaticResource BrandPrimaryBrush}" FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding ShortcutHint}" FontSize="11" Foreground="{StaticResource TextDisabledBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Footer -->
        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <TextBlock x:Name="StatusCountText" Text="15 tools available" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="CancelButton_Click" IsCancel="True" />
                <Button x:Name="RunButton" Content="Run Selected Tool" Style="{StaticResource PrimaryButtonStyle}" Click="RunButton_Click" IsDefault="True" />
            </StackPanel>
        </DockPanel>
    </Grid>
</controls:BaseDialogWindow>
