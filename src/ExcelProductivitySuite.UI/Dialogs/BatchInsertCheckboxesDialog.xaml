<controls:BaseDialogWindow x:Class="ExcelProductivitySuite.UI.Dialogs.BatchInsertCheckboxesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:ExcelProductivitySuite.UI.Controls"
        mc:Ignorable="d"
        Title="Batch Insert Smart Checkboxes - Excel Productivity Suite"
        Height="540" Width="510"
        MinHeight="500" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#F8F9FA">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Brushes.xaml" />
                <ResourceDictionary Source="../Themes/Typography.xaml" />
                <ResourceDictionary Source="../Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{StaticResource BrandPrimaryBrush}" CornerRadius="4" Width="28" Height="28" Margin="0,0,10,0">
                    <TextBlock Text="☑" Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel>
                    <TextBlock Text="Batch Insert Smart Checkboxes" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Quickly insert multiple interactive checkboxes across cells with smart linking" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- Content Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- Target Range -->
                <GroupBox Header="Target Cell Range" Style="{StaticResource ModernGroupBoxStyle}" Margin="0,0,0,10">
                    <StackPanel Margin="6">
                        <TextBlock Text="Select cells where checkboxes will be inserted:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SourceRangeText" Style="{StaticResource ModernTextBoxStyle}" VerticalContentAlignment="Center" TextChanged="SourceRangeText_TextChanged" />
                            <Button Grid.Column="1" x:Name="SelectSourceRangeButton" Style="{StaticResource RangeSelectButtonStyle}" Margin="4,0,0,0" ToolTip="Select cells in worksheet" Click="SelectSourceRange_Click" />
                        </Grid>
                        <TextBlock x:Name="RangeCountText" Text="Cells selected: 0" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,0" />
                    </StackPanel>
                </GroupBox>

                <!-- Cell Linking Modes -->
                <GroupBox Header="Cell Linking Modes" Style="{StaticResource ModernGroupBoxStyle}" Margin="0,0,0,10">
                    <StackPanel Margin="6">
                        <RadioButton x:Name="RadioNone" Content="Insert checkboxes only" Style="{StaticResource ModernRadioButtonStyle}" Margin="0,0,0,2" Checked="LinkMode_Changed" />
                        <TextBlock Text="Places visual checkboxes without linking them to any underlying cell values." FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="20,-2,0,8" />

                        <RadioButton x:Name="RadioOwnCell" Content="Insert checkboxes and link to their own cells" IsChecked="True" Style="{StaticResource ModernRadioButtonStyle}" Margin="0,0,0,2" Checked="LinkMode_Changed" />
                        <TextBlock Text="Each checkbox links to its own cell, toggling TRUE / FALSE directly in the dataset." FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="20,-2,0,8" />

                        <RadioButton x:Name="RadioOtherCells" Content="Insert checkboxes and link to other cells" Style="{StaticResource ModernRadioButtonStyle}" Margin="0,0,0,2" Checked="LinkMode_Changed" />
                        <TextBlock Text="Links checkboxes to an external range or column to keep primary data clean." FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="20,-2,0,6" />

                        <!-- Target Link Range Input (Enabled when RadioOtherCells is selected) -->
                        <Grid x:Name="OtherCellsPanel" Margin="20,0,0,4" IsEnabled="False" Opacity="0.6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TargetRangeText" Style="{StaticResource ModernTextBoxStyle}" VerticalContentAlignment="Center" ToolTip="Enter or select starting cell or range for linked TRUE/FALSE values" />
                            <Button Grid.Column="1" x:Name="SelectTargetRangeButton" Style="{StaticResource RangeSelectButtonStyle}" Margin="4,0,0,0" ToolTip="Select target cell or range in worksheet" Click="SelectTargetRange_Click" />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- Additional Options -->
                <GroupBox Header="Options" Style="{StaticResource ModernGroupBoxStyle}" Margin="0,0,0,6">
                    <StackPanel Margin="6">
                        <CheckBox x:Name="UseLabelCheck" Content="Use cell content as checkbox label" IsChecked="False" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,4" />
                        <TextBlock Text="Uses current cell text as the checkbox caption and clears behind it." FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="20,-2,0,6" />

                        <CheckBox x:Name="DisplayLogicalValueCheck" Content="Display logical value (TRUE / FALSE) in linked cells" IsChecked="True" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,4" />
                        <TextBlock Text="Initializes linked cells with boolean values for instant formula compatibility." FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="20,-2,0,6" />

                        <CheckBox x:Name="InitialCheckedCheck" Content="Initial state: Checked" IsChecked="False" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,2" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="DeleteCheckboxesLink" Content="Batch Delete..." Style="{StaticResource ModernSecondaryButtonStyle}" Padding="8,4" FontSize="11" Margin="0,0,8,0" Click="DeleteCheckboxesLink_Click" ToolTip="Remove checkboxes from selection or sheet" />
                <TextBlock x:Name="StatusLabel" Text="Ready" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="OK" Style="{StaticResource ModernPrimaryButtonStyle}" Width="85" Margin="0,0,8,0" Click="ApplyButton_Click" IsDefault="True" />
                <Button Content="Cancel" Style="{StaticResource ModernSecondaryButtonStyle}" Width="75" Click="CancelButton_Click" IsCancel="True" />
            </StackPanel>
        </DockPanel>
    </Grid>
</controls:BaseDialogWindow>
