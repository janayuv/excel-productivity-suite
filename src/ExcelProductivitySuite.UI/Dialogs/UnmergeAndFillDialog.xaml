<controls:BaseDialogWindow x:Class="ExcelProductivitySuite.UI.Dialogs.UnmergeAndFillDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:ExcelProductivitySuite.UI.Controls"
        mc:Ignorable="d"
        Title="Unmerge and Fill Cells - Excel Productivity Suite"
        Height="500" Width="660"
        Background="#F8F9FA">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Brushes.xaml" />
                <ResourceDictionary Source="../Themes/Typography.xaml" />
                <ResourceDictionary Source="../Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{StaticResource BrandPrimaryBrush}" CornerRadius="4" Width="28" Height="28" Margin="0,0,10,0">
                    <TextBlock Text="🧩" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel>
                    <TextBlock Text="Unmerge and Fill Cells" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Safely unmerge composite cells and automatically propagate values to all constituent cells" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- Detected Merged Areas -->
        <GroupBox Grid.Row="1" Header="Merged Cell Blocks Found in Selection" Style="{StaticResource ModernGroupBoxStyle}">
            <DataGrid x:Name="MergedAreasGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      BorderThickness="1" BorderBrush="#D1D5DB" Background="White">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Cell Address" Binding="{Binding Address}" Width="120" FontWeight="SemiBold" FontFamily="Consolas" />
                    <DataGridTextColumn Header="Block Size" Binding="{Binding SizeDisplay}" Width="110" />
                    <DataGridTextColumn Header="Composite Value to Fill" Binding="{Binding ValueText}" Width="*" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimaryBrush}" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- Status -->
        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,8,0,12" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Text="Ready to unmerge and fill." />

        <!-- Actions -->
        <DockPanel Grid.Row="3" LastChildFill="False">
            <Button x:Name="CloseBtn" Content="Close" Style="{StaticResource ModernSecondaryButtonStyle}" DockPanel.Dock="Right" Width="80" Click="CloseBtn_Click" Margin="8,0,0,0" />
            <Button x:Name="UnmergeBtn" Content="Unmerge &amp; Fill Cells" Style="{StaticResource ModernPrimaryButtonStyle}" DockPanel.Dock="Right" Width="160" Click="UnmergeBtn_Click" />
        </DockPanel>
    </Grid>
</controls:BaseDialogWindow>
