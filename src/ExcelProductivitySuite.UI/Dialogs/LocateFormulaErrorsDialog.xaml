<controls:BaseDialogWindow x:Class="ExcelProductivitySuite.UI.Dialogs.LocateFormulaErrorsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:ExcelProductivitySuite.UI.Controls"
        mc:Ignorable="d"
        Title="Locate Formula Errors - Excel Productivity Suite"
        Height="500" Width="640"
        Background="#F8F9FA">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Brushes.xaml" />
                <ResourceDictionary Source="../Themes/Typography.xaml" />
                <ResourceDictionary Source="../Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{StaticResource BrandPrimaryBrush}" CornerRadius="4" Width="28" Height="28" Margin="0,0,10,0">
                    <TextBlock Text="⚠️" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel>
                    <TextBlock Text="Locate Formula Errors" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Audit, navigate, and highlight formula calculation errors across the worksheet" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- Scope and Filter options -->
        <GroupBox Grid.Row="1" Header="Scan Scope &amp; Error Filter" Style="{StaticResource ModernGroupBoxStyle}">
            <DockPanel Margin="4">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="Scope:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" />
                    <RadioButton x:Name="SheetScopeRadio" Content="Entire Worksheet" IsChecked="True" Style="{StaticResource ModernRadioButtonStyle}" Margin="0,0,12,0" Checked="Filter_Changed" />
                    <RadioButton x:Name="SelectionScopeRadio" Content="Current Selection" Style="{StaticResource ModernRadioButtonStyle}" Margin="0,0,16,0" Checked="Filter_Changed" />

                    <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" />
                    <ComboBox x:Name="ErrorTypeCombo" Width="120" Style="{StaticResource ModernComboBoxStyle}" SelectionChanged="Filter_Changed" />
                </StackPanel>
                <Button Content="Refresh" Width="70" DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource ModernSecondaryButtonStyle}" Click="Refresh_Click" />
            </DockPanel>
        </GroupBox>

        <!-- Errors DataGrid -->
        <GroupBox Grid.Row="2" Header="Detected Errors" Style="{StaticResource ModernGroupBoxStyle}" Margin="0,10,0,10">
            <DataGrid x:Name="ErrorsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E9ECEF" Background="White"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      BorderThickness="1" BorderBrush="#DEE2E6"
                      SelectionChanged="ErrorsGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Cell Address" Binding="{Binding CellAddress}" Width="100" />
                    <DataGridTextColumn Header="Error Type" Binding="{Binding ErrorText}" Width="90">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Foreground" Value="#DC3545" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Formula" Binding="{Binding Formula}" Width="*" />
                    <DataGridTextColumn Header="Worksheet" Binding="{Binding SheetName}" Width="100" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- Footer / Action Buttons -->
        <DockPanel Grid.Row="3">
            <TextBlock x:Name="StatusLabel" Text="Found 0 error(s)" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Go to Cell" Width="90" Margin="0,0,8,0" Style="{StaticResource ModernSecondaryButtonStyle}" Click="GoToCell_Click" />
                <Button Content="Select All in Excel" Width="120" Margin="0,0,8,0" Style="{StaticResource ModernSecondaryButtonStyle}" Click="SelectAllErrors_Click" />
                <Button Content="Highlight Errors" Width="110" Margin="0,0,8,0" Style="{StaticResource ModernPrimaryButtonStyle}" Click="HighlightErrors_Click" />
                <Button Content="Close" Width="70" Style="{StaticResource ModernSecondaryButtonStyle}" Click="Close_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</controls:BaseDialogWindow>
