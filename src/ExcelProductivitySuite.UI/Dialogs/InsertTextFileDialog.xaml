<controls:BaseDialogWindow x:Class="ExcelProductivitySuite.UI.Dialogs.InsertTextFileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:ExcelProductivitySuite.UI.Controls"
        mc:Ignorable="d"
        Title="Insert Text File - Excel Productivity Suite"
        Height="420" Width="480"
        Background="#F8F9FA">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Brushes.xaml" />
                <ResourceDictionary Source="../Themes/Typography.xaml" />
                <ResourceDictionary Source="../Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{StaticResource BrandPrimaryBrush}" CornerRadius="4" Width="28" Height="28" Margin="0,0,10,0">
                    <TextBlock Text="📄" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel>
                    <TextBlock Text="Insert Text File" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Insert raw plain text, log files, or code directly into the active cell or column" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- File Picker -->
        <GroupBox Grid.Row="1" Header="Source Text File" Style="{StaticResource ModernGroupBoxStyle}">
            <DockPanel Margin="4">
                <Button Content="Browse..." Width="80" DockPanel.Dock="Right" Style="{StaticResource ModernSecondaryButtonStyle}" Click="Browse_Click" />
                <TextBox x:Name="FilePathText" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,8,0" />
            </DockPanel>
        </GroupBox>

        <!-- Insertion Layout Options -->
        <GroupBox Grid.Row="2" Header="Insertion Layout &amp; Encoding" Style="{StaticResource ModernGroupBoxStyle}" Margin="0,10,0,12">
            <StackPanel Margin="4">
                <RadioButton x:Name="RowByRowRadio" Content="Row-by-Row: Place each line into a separate row" IsChecked="True" Style="{StaticResource ModernRadioButtonStyle}" Margin="0,0,0,6" />
                <TextBlock Text="Splits text by newline characters so each line occupies an independent cell downwards." FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="20,-4,0,8" />

                <RadioButton x:Name="SingleCellRadio" Content="Single Cell: Place entire file into the active cell" Style="{StaticResource ModernRadioButtonStyle}" Margin="0,0,0,6" />
                <TextBlock Text="Preserves all line breaks and carriage returns within a single multiline cell." FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="20,-4,0,12" />

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Text Encoding:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" />
                    <ComboBox x:Name="EncodingCombo" Width="140" Style="{StaticResource ModernComboBoxStyle}" />
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- Footer / Action Buttons -->
        <DockPanel Grid.Row="3">
            <TextBlock x:Name="StatusLabel" Text="Ready" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Insert File" Width="100" Margin="0,0,8,0" Style="{StaticResource ModernPrimaryButtonStyle}" Click="Insert_Click" />
                <Button Content="Close" Width="75" Style="{StaticResource ModernSecondaryButtonStyle}" Click="Cancel_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</controls:BaseDialogWindow>
