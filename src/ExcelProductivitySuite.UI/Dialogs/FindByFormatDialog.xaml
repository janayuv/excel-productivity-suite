<controls:BaseDialogWindow x:Class="ExcelProductivitySuite.UI.Dialogs.FindByFormatDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:ExcelProductivitySuite.UI.Controls"
        mc:Ignorable="d"
        Title="Find Cells by Format &amp; Color - Excel Productivity Suite"
        Height="560" Width="760"
        Background="#F8F9FA">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Brushes.xaml" />
                <ResourceDictionary Source="../Themes/Typography.xaml" />
                <ResourceDictionary Source="../Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{StaticResource BrandPrimaryBrush}" CornerRadius="4" Width="28" Height="28" Margin="0,0,10,0">
                    <TextBlock Text="🎨" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel>
                    <TextBlock Text="Find Cells by Format &amp; Color" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Locate, list, and select cells matching background fill, font color, bold, or italic styles" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- Criteria Configuration Bar -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Checkboxes Row -->
                <WrapPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                    <CheckBox x:Name="MatchFillCheck" Content="Match Fill Background" IsChecked="True" Margin="0,0,14,4" />
                    <CheckBox x:Name="MatchFontColorCheck" Content="Match Font Color" Margin="0,0,14,4" />
                    <CheckBox x:Name="MatchBoldCheck" Content="Match Bold" Margin="0,0,14,4" />
                    <CheckBox x:Name="MatchItalicCheck" Content="Match Italic" Margin="0,0,14,4" />
                </WrapPanel>

                <!-- Pick from Active Cell Button -->
                <Button x:Name="PickFromActiveCellBtn" Grid.Row="0" Grid.Column="1" Content="🎯 Pick from Active Cell" Style="{StaticResource ModernSecondaryButtonStyle}" Height="28" Click="PickFromActiveCellBtn_Click" />

                <!-- Scope & Search Button Row -->
                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0">
                    <TextBlock Text="Scope:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" />
                    <RadioButton x:Name="ScopeSheetRadio" Content="Active Worksheet" IsChecked="True" Margin="0,0,12,0" />
                    <RadioButton x:Name="ScopeSelectionRadio" Content="Active Selection Only" />
                </StackPanel>

                <Button x:Name="SearchBtn" Grid.Row="1" Grid.Column="1" Content="🔍 Find Matches" Style="{StaticResource ModernPrimaryButtonStyle}" Height="28" Width="120" Margin="0,8,0,0" Click="SearchBtn_Click" />
            </Grid>
        </Border>

        <!-- Matches Grid -->
        <GroupBox Grid.Row="2" Header="Matching Cells Found" Style="{StaticResource ModernGroupBoxStyle}">
            <DataGrid x:Name="MatchesGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      BorderThickness="1" BorderBrush="#D1D5DB" Background="White"
                      MouseDoubleClick="MatchesGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="90" FontWeight="SemiBold" FontFamily="Consolas" />
                    <DataGridTextColumn Header="Cell Value" Binding="{Binding ValueText}" Width="150" />
                    <DataGridTextColumn Header="Fill Color" Binding="{Binding FillHex}" Width="110" FontFamily="Consolas" />
                    <DataGridTextColumn Header="Font Color" Binding="{Binding FontHex}" Width="110" FontFamily="Consolas" />
                    <DataGridCheckBoxColumn Header="Bold" Binding="{Binding IsBold}" Width="65" />
                    <DataGridCheckBoxColumn Header="Italic" Binding="{Binding IsItalic}" Width="65" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- Status -->
        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,8,0,12" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Text="Choose format criteria or pick from active cell, then click Find Matches." />

        <!-- Actions -->
        <DockPanel Grid.Row="4" LastChildFill="False">
            <Button x:Name="CloseBtn" Content="Close" Style="{StaticResource ModernSecondaryButtonStyle}" DockPanel.Dock="Right" Width="80" Click="CloseBtn_Click" Margin="8,0,0,0" />
            <Button x:Name="SelectAllBtn" Content="Select All in Excel" Style="{StaticResource ModernPrimaryButtonStyle}" DockPanel.Dock="Right" Width="150" IsEnabled="False" Click="SelectAllBtn_Click" />
        </DockPanel>
    </Grid>
</controls:BaseDialogWindow>
