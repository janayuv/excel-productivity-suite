<controls:BaseDialogWindow x:Class="ExcelProductivitySuite.UI.Dialogs.ReadingViewSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ExcelProductivitySuite.UI.Controls"
        Title="Grid Focus / Reading Layout Settings - Excel Productivity Suite"
        Height="560" Width="720"
        MinHeight="500" MinWidth="650"
        WindowStartupLocation="CenterOwner"
        Background="#F8F9FA">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Brushes.xaml" />
                <ResourceDictionary Source="../Themes/Typography.xaml" />
                <ResourceDictionary Source="../Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto" />
            <!-- Body: Left settings, Right preview -->
            <RowDefinition Height="*" />
            <!-- Footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{StaticResource BrandPrimaryBrush}" CornerRadius="4" Width="32" Height="32" Margin="0,0,10,0">
                    <TextBlock Text="🎯" Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel>
                    <TextBlock Text="Grid Focus &amp; Reading Layout Settings" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Highlight the active cell's row and column (crosshair) to easily trace data across dense worksheets" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- BODY -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: SETTINGS -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Highlight Shape -->
                    <GroupBox Header="Highlight Shape &amp; Style" Style="{StaticResource ModernGroupBoxStyle}" Margin="0,0,0,10">
                        <StackPanel Margin="4">
                            <RadioButton x:Name="RbCrosshair" Content="➕ Crosshair (Both Row &amp; Column)" IsChecked="True" Checked="Shape_Changed" Margin="0,3" />
                            <RadioButton x:Name="RbRowOnly" Content="═ Row Only (Active Row)" Checked="Shape_Changed" Margin="0,3" />
                            <RadioButton x:Name="RbColOnly" Content="║ Column Only (Active Column)" Checked="Shape_Changed" Margin="0,3" />
                            <RadioButton x:Name="RbCellOnly" Content="🔲 Active Cell Focus Only" Checked="Shape_Changed" Margin="0,3" />
                        </StackPanel>
                    </GroupBox>

                    <!-- Scope -->
                    <GroupBox Header="Highlight Boundary Scope" Style="{StaticResource ModernGroupBoxStyle}" Margin="0,0,0,10">
                        <StackPanel Margin="4">
                            <RadioButton x:Name="RbScopeFull" Content="Entire Row &amp; Column (Full Grid)" IsChecked="True" Checked="Scope_Changed" Margin="0,3" />
                            <RadioButton x:Name="RbScopeUsed" Content="Data Region Only (UsedRange Bounded)" Checked="Scope_Changed" Margin="0,3" />
                        </StackPanel>
                    </GroupBox>

                    <!-- Color Swatches -->
                    <GroupBox Header="Highlight Color Palette" Style="{StaticResource ModernGroupBoxStyle}" Margin="0,0,0,10">
                        <StackPanel Margin="4">
                            <WrapPanel Margin="0,2,0,8">
                                <Button Width="36" Height="28" Background="#38BDF8" BorderBrush="#0284C7" BorderThickness="2" Margin="0,0,6,4" ToolTip="Sky Blue" Click="ColorPreset_Click" Tag="#38BDF8" />
                                <Button Width="36" Height="28" Background="#34D399" BorderBrush="#059669" BorderThickness="2" Margin="0,0,6,4" ToolTip="Emerald Green" Click="ColorPreset_Click" Tag="#34D399" />
                                <Button Width="36" Height="28" Background="#FBBF24" BorderBrush="#D97706" BorderThickness="2" Margin="0,0,6,4" ToolTip="Warm Amber" Click="ColorPreset_Click" Tag="#FBBF24" />
                                <Button Width="36" Height="28" Background="#FB7185" BorderBrush="#E11D48" BorderThickness="2" Margin="0,0,6,4" ToolTip="Rose Pink" Click="ColorPreset_Click" Tag="#FB7185" />
                                <Button Width="36" Height="28" Background="#A78BFA" BorderBrush="#7C3AED" BorderThickness="2" Margin="0,0,6,4" ToolTip="Lavender Purple" Click="ColorPreset_Click" Tag="#A78BFA" />
                                <Button Width="36" Height="28" Background="#94A3B8" BorderBrush="#475569" BorderThickness="2" Margin="0,0,6,4" ToolTip="Slate Gray" Click="ColorPreset_Click" Tag="#94A3B8" />
                            </WrapPanel>

                            <DockPanel Margin="0,2,0,0">
                                <TextBlock Text="Custom Hex:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <Border x:Name="ColorIndicator" Width="22" Height="22" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="3" DockPanel.Dock="Right" Margin="6,0,0,0" Background="#38BDF8" />
                                <TextBox x:Name="HexInput" Style="{StaticResource ModernTextBoxStyle}" Text="#38BDF8" MaxLength="7" TextChanged="HexInput_TextChanged" />
                            </DockPanel>
                        </StackPanel>
                    </GroupBox>

                    <!-- Transparency Slider -->
                    <GroupBox Header="Transparency &amp; Borders" Style="{StaticResource ModernGroupBoxStyle}">
                        <StackPanel Margin="4">
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="Transparency Level:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock x:Name="TransValueText" Text="75% Transparent" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                            </DockPanel>
                            <Slider x:Name="TransSlider" Minimum="10" Maximum="90" Value="75" SmallChange="5" LargeChange="10" TickFrequency="10" IsSnapToTickEnabled="False" ValueChanged="TransSlider_ValueChanged" Margin="0,2,0,6" />
                            <CheckBox x:Name="BorderCheck" Content="Display outline border on highlight crosshair" IsChecked="True" Checked="Border_Changed" Unchecked="Border_Changed" Margin="0,4,0,0" />
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <!-- RIGHT: LIVE PREVIEW -->
            <GroupBox Grid.Column="2" Header="Live Before &amp; After Preview" Style="{StaticResource ModernGroupBoxStyle}">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Simulated worksheet grid tracking active cell [C3]:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" />

                    <!-- Mock Table Container with Highlight Canvas Overlay -->
                    <Border Grid.Row="1" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                        <Grid x:Name="PreviewContainer">
                            <!-- Background Table Grid -->
                            <Grid x:Name="PreviewGrid">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="28" /> <!-- Header -->
                                    <RowDefinition Height="26" /> <!-- Row 1 -->
                                    <RowDefinition Height="26" /> <!-- Row 2 -->
                                    <RowDefinition Height="26" /> <!-- Row 3 (Active) -->
                                    <RowDefinition Height="26" /> <!-- Row 4 -->
                                    <RowDefinition Height="26" /> <!-- Row 5 -->
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" /> <!-- Header col -->
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" /> <!-- Col C (Active) -->
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Column Headers -->
                                <Border Grid.Row="0" Grid.Column="0" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1"><TextBlock Text="" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" /></Border>
                                <Border Grid.Row="0" Grid.Column="1" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1"><TextBlock Text="A (Date)" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="Bold" /></Border>
                                <Border Grid.Row="0" Grid.Column="2" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1"><TextBlock Text="B (Product)" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="Bold" /></Border>
                                <Border Grid.Row="0" Grid.Column="3" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1"><TextBlock Text="C (Region)" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="Bold" /></Border>
                                <Border Grid.Row="0" Grid.Column="4" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"><TextBlock Text="D (Revenue)" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="Bold" /></Border>

                                <!-- Row 1 -->
                                <Border Grid.Row="1" Grid.Column="0" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1"><TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" /></Border>
                                <Border Grid.Row="1" Grid.Column="1" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1"><TextBlock Text="2026-10-01" Margin="6,4" FontSize="11" /></Border>
                                <Border Grid.Row="1" Grid.Column="2" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1"><TextBlock Text="Office Suite" Margin="6,4" FontSize="11" /></Border>
                                <Border Grid.Row="1" Grid.Column="3" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1"><TextBlock Text="US-East" Margin="6,4" FontSize="11" /></Border>
                                <Border Grid.Row="1" Grid.Column="4" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"><TextBlock Text="$14,250" Margin="6,4" FontSize="11" HorizontalAlignment="Right" /></Border>

                                <!-- Row 2 -->
                                <Border Grid.Row="2" Grid.Column="0" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" /></Border>
                                <Border Grid.Row="2" Grid.Column="1" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1"><TextBlock Text="2026-10-02" Margin="6,4" FontSize="11" /></Border>
                                <Border Grid.Row="2" Grid.Column="2" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1"><TextBlock Text="Cloud Storage" Margin="6,4" FontSize="11" /></Border>
                                <Border Grid.Row="2" Grid.Column="3" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1"><TextBlock Text="EU-Central" Margin="6,4" FontSize="11" /></Border>
                                <Border Grid.Row="2" Grid.Column="4" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"><TextBlock Text="$28,900" Margin="6,4" FontSize="11" HorizontalAlignment="Right" /></Border>

                                <!-- Row 3 (Active Row) -->
                                <Border Grid.Row="3" Grid.Column="0" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1"><TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="Bold" /></Border>
                                <Border Grid.Row="3" Grid.Column="1" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1"><TextBlock Text="2026-10-03" Margin="6,4" FontSize="11" /></Border>
                                <Border Grid.Row="3" Grid.Column="2" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1"><TextBlock Text="Analytics Pro" Margin="6,4" FontSize="11" /></Border>
                                <Border Grid.Row="3" Grid.Column="3" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1"><TextBlock Text="US-West" Margin="6,4" FontSize="11" FontWeight="Bold" /></Border>
                                <Border Grid.Row="3" Grid.Column="4" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"><TextBlock Text="$54,120" Margin="6,4" FontSize="11" HorizontalAlignment="Right" /></Border>

                                <!-- Row 4 -->
                                <Border Grid.Row="4" Grid.Column="0" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1"><TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" /></Border>
                                <Border Grid.Row="4" Grid.Column="1" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1"><TextBlock Text="2026-10-04" Margin="6,4" FontSize="11" /></Border>
                                <Border Grid.Row="4" Grid.Column="2" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1"><TextBlock Text="Data Bridge" Margin="6,4" FontSize="11" /></Border>
                                <Border Grid.Row="4" Grid.Column="3" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1"><TextBlock Text="AP-South" Margin="6,4" FontSize="11" /></Border>
                                <Border Grid.Row="4" Grid.Column="4" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"><TextBlock Text="$9,800" Margin="6,4" FontSize="11" HorizontalAlignment="Right" /></Border>

                                <!-- Row 5 -->
                                <Border Grid.Row="5" Grid.Column="0" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0"><TextBlock Text="5" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" /></Border>
                                <Border Grid.Row="5" Grid.Column="1" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0"><TextBlock Text="2026-10-05" Margin="6,4" FontSize="11" /></Border>
                                <Border Grid.Row="5" Grid.Column="2" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0"><TextBlock Text="Security Gateway" Margin="6,4" FontSize="11" /></Border>
                                <Border Grid.Row="5" Grid.Column="3" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0"><TextBlock Text="US-East" Margin="6,4" FontSize="11" /></Border>
                                <Border Grid.Row="5" Grid.Column="4" BorderBrush="#E2E8F0" BorderThickness="0,0,0,0"><TextBlock Text="$41,500" Margin="6,4" FontSize="11" HorizontalAlignment="Right" /></Border>
                            </Grid>

                            <!-- Overlay Dynamic Shapes for Row, Column, Cell -->
                            <!-- Row Highlight Overlay -->
                            <Border x:Name="PreviewRowHighlight" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="5"
                                    Background="#38BDF8" Opacity="0.25" IsHitTestVisible="False" Margin="0,0,0,1" />

                            <!-- Column Highlight Overlay -->
                            <Border x:Name="PreviewColHighlight" Grid.Row="0" Grid.RowSpan="6" Grid.Column="3"
                                    Background="#38BDF8" Opacity="0.25" IsHitTestVisible="False" Margin="0,0,1,0" />

                            <!-- Active Cell Highlight Overlay -->
                            <Border x:Name="PreviewCellBorder" Grid.Row="3" Grid.Column="3"
                                    BorderBrush="#0284C7" BorderThickness="2" IsHitTestVisible="False" Margin="0,0,1,1" />
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="2" Text="• Move cell or click in Excel to see the crosshair follow in real time." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0" />
                </Grid>
            </GroupBox>
        </Grid>

        <!-- FOOTER ACTIONS -->
        <DockPanel Grid.Row="2">
            <Button Content="Close" Style="{StaticResource ModernSecondaryButtonStyle}" DockPanel.Dock="Right" Width="80" IsCancel="True" Click="Close_Click" />
            <Button x:Name="DisableButton" Content="Turn Off Grid Focus" Style="{StaticResource ModernSecondaryButtonStyle}" DockPanel.Dock="Right" Width="160" Margin="0,0,8,0" Click="Disable_Click" />
            <Button x:Name="EnableButton" Content="Turn On Grid Focus" Style="{StaticResource ModernPrimaryButtonStyle}" DockPanel.Dock="Right" Width="160" Margin="0,0,8,0" IsDefault="True" Click="Enable_Click" />
            <TextBlock x:Name="CurrentStatusBadge" Text="Status: Grid Focus is currently OFF" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</controls:BaseDialogWindow>
