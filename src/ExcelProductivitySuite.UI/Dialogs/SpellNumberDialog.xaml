<controls:BaseDialogWindow x:Class="ExcelProductivitySuite.UI.Dialogs.SpellNumberDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:ExcelProductivitySuite.UI.Controls"
        mc:Ignorable="d"
        Title="Convert Numbers to Words - Excel Productivity Suite"
        Height="540" Width="640"
        Background="#F8F9FA">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Brushes.xaml" />
                <ResourceDictionary Source="../Themes/Typography.xaml" />
                <ResourceDictionary Source="../Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{StaticResource BrandPrimaryBrush}" CornerRadius="4" Width="28" Height="28" Margin="0,0,10,0">
                    <TextBlock Text="🔤" Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel>
                    <TextBlock Text="Convert Numbers to Words (SpellNumber)" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Generate written English words for currency amounts or numbers (invoices, checks, receipts)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- Options -->
        <GroupBox Grid.Row="1" Header="SpellNumber Options" Style="{StaticResource ModernGroupBoxStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Mode:" VerticalAlignment="Center" Width="75" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    <ComboBox x:Name="ModeComboBox" Width="170" SelectionChanged="OptionChanged" FontSize="11">
                        <ComboBoxItem Content="Currency Words" Tag="Currency" IsSelected="True" />
                        <ComboBoxItem Content="Pure Number Words" Tag="PureNumber" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Currency:" VerticalAlignment="Center" Width="70" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    <ComboBox x:Name="CurrencyComboBox" Width="170" SelectionChanged="OptionChanged" FontSize="11">
                        <ComboBoxItem Content="USD (Dollars &amp; Cents)" Tag="USD" IsSelected="True" />
                        <ComboBoxItem Content="EUR (Euros &amp; Cents)" Tag="EUR" />
                        <ComboBoxItem Content="GBP (Pounds &amp; Pence)" Tag="GBP" />
                        <ComboBoxItem Content="INR (Rupees &amp; Paise)" Tag="INR" />
                        <ComboBoxItem Content="Generic (Units &amp; Hundredths)" Tag="Generic" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Letter Case:" VerticalAlignment="Center" Width="75" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    <ComboBox x:Name="CaseComboBox" Width="170" SelectionChanged="OptionChanged" FontSize="11">
                        <ComboBoxItem Content="Title Case (One Thousand...)" Tag="TitleCase" IsSelected="True" />
                        <ComboBoxItem Content="UPPERCASE (ONE THOUSAND...)" Tag="UpperCase" />
                        <ComboBoxItem Content="lowercase (one thousand...)" Tag="LowerCase" />
                        <ComboBoxItem Content="Sentence case (One thousand...)" Tag="SentenceCase" />
                    </ComboBox>
                </StackPanel>

                <CheckBox Grid.Row="1" Grid.Column="1" x:Name="ZeroCentsCheck" Content="Include zero cents ('and Zero Cents')" IsChecked="True" Style="{StaticResource ModernCheckBoxStyle}" VerticalAlignment="Center" Checked="OptionChanged" Unchecked="OptionChanged" />
            </Grid>
        </GroupBox>

        <!-- Live Preview -->
        <DockPanel Grid.Row="2" Margin="0,8,0,0">
            <TextBlock DockPanel.Dock="Top" Text="Live Preview (First 10 Cells):" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
            <controls:LivePreviewTable x:Name="PreviewTable" />
        </DockPanel>

        <!-- Footer -->
        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <CheckBox x:Name="OutputAdjacentCheck" Content="Output to adjacent column (preserve original numbers)" IsChecked="True" VerticalAlignment="Center" Style="{StaticResource ModernCheckBoxStyle}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="CancelButton_Click" IsCancel="True" />
                <Button Content="Convert to Words" Style="{StaticResource PrimaryButtonStyle}" Click="ApplyButton_Click" IsDefault="True" />
            </StackPanel>
        </DockPanel>
    </Grid>
</controls:BaseDialogWindow>
