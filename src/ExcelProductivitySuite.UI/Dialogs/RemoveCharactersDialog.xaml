<controls:BaseDialogWindow x:Class="ExcelProductivitySuite.UI.Dialogs.RemoveCharactersDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:ExcelProductivitySuite.UI.Controls"
        mc:Ignorable="d"
        Title="Remove Characters - Excel Productivity Suite"
        Height="490" Width="580"
        Background="#F8F9FA">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Brushes.xaml" />
                <ResourceDictionary Source="../Themes/Typography.xaml" />
                <ResourceDictionary Source="../Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{StaticResource BrandPrimaryBrush}" CornerRadius="4" Width="28" Height="28" Margin="0,0,10,0">
                    <TextBlock Text="⌫" Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel>
                    <TextBlock Text="Remove Characters" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Strip specific character types or custom symbols from selected cells" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- Options Checkboxes -->
        <GroupBox Grid.Row="1" Header="Characters to Remove" Style="{StaticResource ModernGroupBoxStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Row="0" Grid.Column="0" x:Name="RemoveNumericCheck" Content="Numeric characters (0-9)" Style="{StaticResource ModernCheckBoxStyle}" Checked="OptionChanged" Unchecked="OptionChanged" />
                <CheckBox Grid.Row="0" Grid.Column="1" x:Name="RemoveAlphaCheck" Content="Alpha characters (a-z, A-Z)" Style="{StaticResource ModernCheckBoxStyle}" Checked="OptionChanged" Unchecked="OptionChanged" />
                
                <CheckBox Grid.Row="1" Grid.Column="0" x:Name="RemoveSymbolsCheck" Content="Non-alphanumeric / Symbols" Style="{StaticResource ModernCheckBoxStyle}" Checked="OptionChanged" Unchecked="OptionChanged" />
                <CheckBox Grid.Row="1" Grid.Column="1" x:Name="RemoveControlCheck" Content="Non-printable / Control characters" Style="{StaticResource ModernCheckBoxStyle}" Checked="OptionChanged" Unchecked="OptionChanged" />

                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,6,0,0">
                    <CheckBox x:Name="RemoveCustomCheck" Content="Custom characters:" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,8,0" Checked="OptionChanged" Unchecked="OptionChanged" />
                    <TextBox x:Name="CustomCharsTextBox" Width="180" Style="{StaticResource ModernTextBoxStyle}" Text="!@#$%" IsEnabled="False" TextChanged="OptionChanged" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Live Preview -->
        <DockPanel Grid.Row="2" Margin="0,8,0,0">
            <TextBlock DockPanel.Dock="Top" Text="Live Preview (First 10 Cells):" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
            <controls:LivePreviewTable x:Name="PreviewTable" />
        </DockPanel>

        <!-- Footer -->
        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="Safe in-memory operation" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="CancelButton_Click" IsCancel="True" />
                <Button Content="Remove Characters" Style="{StaticResource PrimaryButtonStyle}" Click="ApplyButton_Click" IsDefault="True" />
            </StackPanel>
        </DockPanel>
    </Grid>
</controls:BaseDialogWindow>
