<controls:BaseDialogWindow x:Class="ExcelProductivitySuite.UI.Dialogs.ChangeSignDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:ExcelProductivitySuite.UI.Controls"
        mc:Ignorable="d"
        Title="Change Sign - Excel Productivity Suite"
        Height="490" Width="580"
        Background="#F8F9FA">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Brushes.xaml" />
                <ResourceDictionary Source="../Themes/Typography.xaml" />
                <ResourceDictionary Source="../Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{StaticResource BrandPrimaryBrush}" CornerRadius="4" Width="28" Height="28" Margin="0,0,10,0">
                    <TextBlock Text="±" Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel>
                    <TextBlock Text="Change Sign of Values" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Invert or enforce positive/negative signs on all numeric cells in the selected range" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- Options -->
        <GroupBox Grid.Row="1" Header="Sign Transformation Operation" Style="{StaticResource ModernGroupBoxStyle}">
            <StackPanel>
                <RadioButton x:Name="InvertRadio" Content="Invert sign of all values (e.g. 50 ➔ -50, -12 ➔ 12)" IsChecked="True" Style="{StaticResource ModernRadioButtonStyle}" Checked="OptionChanged" />
                <RadioButton x:Name="MakePositiveRadio" Content="Make all values positive (Absolute value |x|)" Style="{StaticResource ModernRadioButtonStyle}" Checked="OptionChanged" />
                <RadioButton x:Name="MakeNegativeRadio" Content="Make all values negative (-|x|)" Style="{StaticResource ModernRadioButtonStyle}" Checked="OptionChanged" />
                <RadioButton x:Name="ReverseNegativeRadio" Content="Reverse sign of negative values only (negatives become positive)" Style="{StaticResource ModernRadioButtonStyle}" Checked="OptionChanged" />
                <RadioButton x:Name="ReversePositiveRadio" Content="Reverse sign of positive values only (positives become negative)" Style="{StaticResource ModernRadioButtonStyle}" Checked="OptionChanged" />
            </StackPanel>
        </GroupBox>

        <!-- Live Preview -->
        <DockPanel Grid.Row="2" Margin="0,8,0,0">
            <TextBlock DockPanel.Dock="Top" Text="Live Preview (First 10 Cells):" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
            <controls:LivePreviewTable x:Name="PreviewTable" />
        </DockPanel>

        <!-- Footer -->
        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="Safe in-memory batch processing" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="CancelButton_Click" IsCancel="True" />
                <Button Content="Change Sign" Style="{StaticResource PrimaryButtonStyle}" Click="ApplyButton_Click" IsDefault="True" />
            </StackPanel>
        </DockPanel>
    </Grid>
</controls:BaseDialogWindow>
