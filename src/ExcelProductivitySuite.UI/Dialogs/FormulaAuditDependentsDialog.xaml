<controls:BaseDialogWindow x:Class="ExcelProductivitySuite.UI.Dialogs.FormulaAuditDependentsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:ExcelProductivitySuite.UI.Controls"
        mc:Ignorable="d"
        Title="Audit Formula Dependents - Excel Productivity Suite"
        Height="540" Width="720"
        Background="#F8F9FA">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Brushes.xaml" />
                <ResourceDictionary Source="../Themes/Typography.xaml" />
                <ResourceDictionary Source="../Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{StaticResource BrandPrimaryBrush}" CornerRadius="4" Width="28" Height="28" Margin="0,0,10,0">
                    <TextBlock Text="🎯" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel>
                    <TextBlock Text="Audit Formula Dependents" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Inspect and navigate downstream cells that depend on the active cell" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- Active Cell Banner -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="Active Cell" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock x:Name="ActiveCellText" Text="$A$1" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrandPrimaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Current Value" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock x:Name="ActiveValueText" Text="100.00" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="DirectOnlyRadio" Content="Direct Dependents" IsChecked="True" Margin="0,0,10,0" Checked="Mode_Checked" />
                    <RadioButton x:Name="AllDependentsRadio" Content="All Dependents" Checked="Mode_Checked" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Dependents Grid -->
        <GroupBox Grid.Row="2" Header="Dependent Cells Requiring Active Cell" Style="{StaticResource ModernGroupBoxStyle}">
            <DataGrid x:Name="DependentsGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      BorderThickness="1" BorderBrush="#D1D5DB" Background="White"
                      SelectionChanged="DependentsGrid_SelectionChanged"
                      MouseDoubleClick="DependentsGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Sheet" Binding="{Binding SheetName}" Width="120" />
                    <DataGridTextColumn Header="Cell Address" Binding="{Binding CellAddress}" Width="100" FontWeight="SemiBold" FontFamily="Consolas" />
                    <DataGridTextColumn Header="Evaluated Value" Binding="{Binding ValueText}" Width="140" />
                    <DataGridTextColumn Header="Dependent Formula" Binding="{Binding FormulaDisplay}" Width="*" FontFamily="Consolas" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- Status -->
        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,8,0,12" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Text="Ready" />

        <!-- Action Buttons -->
        <DockPanel Grid.Row="4" LastChildFill="False">
            <Button x:Name="RefreshBtn" Content="🔄 Refresh" Style="{StaticResource ModernSecondaryButtonStyle}" DockPanel.Dock="Left" Width="100" Click="RefreshBtn_Click" />
            <Button x:Name="CloseBtn" Content="Close" Style="{StaticResource ModernSecondaryButtonStyle}" DockPanel.Dock="Right" Width="80" Click="CloseBtn_Click" Margin="8,0,0,0" />
            <Button x:Name="NavigateBtn" Content="Navigate to Cell in Excel" Style="{StaticResource ModernPrimaryButtonStyle}" DockPanel.Dock="Right" Width="170" IsEnabled="False" Click="NavigateBtn_Click" />
        </DockPanel>
    </Grid>
</controls:BaseDialogWindow>
