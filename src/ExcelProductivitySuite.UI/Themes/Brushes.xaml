<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Primary Brand Colors (Office Excel Fluent Alignment) -->
    <Color x:Key="BrandPrimaryColor">#107C41</Color>
    <Color x:Key="BrandHoverColor">#0E6B37</Color>
    <Color x:Key="BrandPressedColor">#0B562C</Color>
    <Color x:Key="BrandLightColor">#E6F2EB</Color>
    <Color x:Key="BrandBorderColor">#A1D4B7</Color>

    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="{StaticResource BrandPrimaryColor}" />
    <SolidColorBrush x:Key="BrandHoverBrush" Color="{StaticResource BrandHoverColor}" />
    <SolidColorBrush x:Key="BrandPressedBrush" Color="{StaticResource BrandPressedColor}" />
    <SolidColorBrush x:Key="BrandLightBrush" Color="{StaticResource BrandLightColor}" />
    <SolidColorBrush x:Key="BrandBorderBrush" Color="{StaticResource BrandBorderColor}" />

    <!-- Neutral Surfaces (Light Theme) -->
    <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceSecondaryBrush" Color="#F8F9FA" />
    <SolidColorBrush x:Key="SurfaceCardBrush" Color="#F3F5F7" />
    <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#DDE0E3" />
    <SolidColorBrush x:Key="BorderLightBrush" Color="#DDE0E3" />
    <SolidColorBrush x:Key="SurfaceDividerBrush" Color="#EAECEF" />

    <!-- Text Palette -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#202124" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5F6368" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#9AA0A6" />
    <SolidColorBrush x:Key="TextOnBrandBrush" Color="#FFFFFF" />

    <!-- Accent & Status Palette -->
    <SolidColorBrush x:Key="AccentBlueBrush" Color="#0078D4" />
    <SolidColorBrush x:Key="StatusSuccessBrush" Color="#107C41" />
    <SolidColorBrush x:Key="StatusWarningBrush" Color="#D83B01" />
    <SolidColorBrush x:Key="StatusErrorBrush" Color="#A80000" />
    <SolidColorBrush x:Key="StatusErrorLightBrush" Color="#FDF3F2" />
    <SolidColorBrush x:Key="StatusWarningLightBrush" Color="#FFF8F0" />
    <SolidColorBrush x:Key="StatusSuccessLightBrush" Color="#EFF8F3" />

</ResourceDictionary>
